{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["home/dot_codex/private_dot_merge-config.ts"],
      "project": ["home/dot_codex/**/*.ts"]
    },
    "home/dot_claude": {
      "entry": ["hooks/implementations/*.ts", "scripts/*.ts"],
      "project": ["**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "ccstatusline",
    "@mizchi/lsmcp",

    "@drawio/mcp",
    "@playwright/mcp",
    "@upstash/context7-mcp",
    "chrome-devtools-mcp",
    "supergateway",

    "tree-sitter-bash"
  ],
  "tags": ["-public"],
  "ignoreBinaries": [
    "ps",
    "which",
    "wslpath",
    "powershell.exe",
    "afplay",
    "paplay",
    "aplay",
    "notify-send"
  ]
}
