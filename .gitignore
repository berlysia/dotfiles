# Zsh completion cache files
home/dot_zsh/.zcompdump*

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
.tmp/

# Local environment files (if any)
.env.local

# ask-grokbot credentials belong at ~/.config/ask-grokbot/env, outside this repo.
# Ignore a copy placed under the chezmoi source tree.
home/dot_config/ask-grokbot/

node_modules

# lsmcp cache
.lsmcp/cache

# TypeScript compiled output
home/dot_claude/**/*.js
!home/dot_claude/**/.*config*.js

# Backup files
*.backup-*


# APM dependencies
apm_modules/

# plan-review-automation writes its cache next to the edited document, which can be outside the workflow dir
plan-review.cache.json

# Mod engine-generated files
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

# Python bytecode (from running the skills' scripts locally)
__pycache__/

# shiori writes its scan result here when run in a terminal
.config/shiori/scan-result.json
