#!/usr/bin/env bash
# Test stub: records the --override-data value and echoes the template from stdin.
# STUB_CHEZMOI_FAIL_ON makes the render fail when the data contains that text.
# shellcheck disable=SC2154 # STUB_* are exported by tests/lint-shell/run.sh
data=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --override-data) data=$2; shift 2 ;;
    --override-data=*) data=${1#--override-data=}; shift ;;
    *) shift ;;
  esac
done
printf 'chezmoi %s\n' "$data" >>"$STUB_LOG"
if [[ -n "${STUB_CHEZMOI_FAIL_ON:-}" && "$data" == *"$STUB_CHEZMOI_FAIL_ON"* ]]; then
  echo "stub chezmoi: render failed" >&2
  exit 1
fi
cat
