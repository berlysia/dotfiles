# Codex execution policy rules
# Scope: shell commands (execvp) only — does NOT affect file editing tools

# === Safety: dangerous commands ===

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive force-delete is too dangerous for automated execution",
)

prefix_rule(
    pattern = ["rm", "-r"],
    decision = "prompt",
    justification = "Recursive delete requires human approval",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "No privilege escalation from agents",
)

prefix_rule(
    pattern = ["pip"],
    decision = "forbidden",
    justification = "Python packages are managed with uv",
)

prefix_rule(
    pattern = ["pip3"],
    decision = "forbidden",
    justification = "Python packages are managed with uv",
)

prefix_rule(
    pattern = ["pipx"],
    decision = "forbidden",
    justification = "Python tools are managed with uv / mise",
)

prefix_rule(
    pattern = ["poetry"],
    decision = "forbidden",
    justification = "Python packages are managed with uv",
)

prefix_rule(
    pattern = ["python", "-m", "pip"],
    decision = "forbidden",
    justification = "Python packages are managed with uv",
)

prefix_rule(
    pattern = ["python3", "-m", "pip"],
    decision = "forbidden",
    justification = "Python packages are managed with uv",
)

# === Safety: destructive git commands ===

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push can destroy remote history",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-push can destroy remote history",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset discards uncommitted changes — requires human approval",
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "prompt",
    justification = "Clean -f removes untracked files — requires human approval",
)

# === Allow: quality commands ===

prefix_rule(
    pattern = ["pnpm", "test"],
    decision = "allow",
    justification = "Running tests is always safe",
)

prefix_rule(
    pattern = ["pnpm", "typecheck"],
    decision = "allow",
    justification = "Type checking is always safe",
)

prefix_rule(
    pattern = ["pnpm", "lint"],
    decision = "allow",
    justification = "Linting is always safe",
)

prefix_rule(
    pattern = ["pnpm", "dev"],
    decision = "allow",
    justification = "Starts the project's dev server",
)

prefix_rule(
    pattern = ["bun", "run", "test"],
    decision = "allow",
    justification = "Running tests is always safe",
)

prefix_rule(
    pattern = ["bun", "test"],
    decision = "allow",
    justification = "Running tests is always safe",
)

prefix_rule(
    pattern = ["bun", "run", "typecheck"],
    decision = "allow",
    justification = "Type checking is always safe",
)

prefix_rule(
    pattern = ["bun", "run", "lint"],
    decision = "allow",
    justification = "Linting is always safe",
)

prefix_rule(
    pattern = ["bun", "run", "lint:fix"],
    decision = "allow",
    justification = "Applying lint autofixes is as safe as formatting",
)

prefix_rule(
    pattern = ["bun", "run", "format"],
    decision = "allow",
    justification = "Formatting with the project's formatter is always safe",
)

prefix_rule(
    pattern = ["bun", "run", "format:check"],
    decision = "allow",
    justification = "Read-only format check",
)

prefix_rule(
    pattern = ["agent-learnings", "show"],
    decision = "allow",
    justification = "Reads per-repository learnings",
)

prefix_rule(
    pattern = ["agent-learnings", "add"],
    decision = "allow",
    justification = "Records a learning through the sandboxed inbox",
)

prefix_rule(
    pattern = ["agent-learnings", "remove"],
    decision = "allow",
    justification = "Removes a learning through the sandboxed inbox",
)

prefix_rule(
    pattern = ["agent-learnings", "feedback"],
    decision = "allow",
    justification = "Records whether an injected learning fit the moment",
)

prefix_rule(
    pattern = ["agent-learnings", "status"],
    decision = "allow",
    justification = "Shows the learnings store health",
)

prefix_rule(
    pattern = ["agent-learnings", "path"],
    decision = "allow",
    justification = "Prints the learnings file path",
)

# dotfiles-feedback: only send / status / flush. A prefix rule matches any
# trailing arguments, so `send --help` and `flush --retry <id>` are allowed too.
# The destination repo is a constant in the CLI and cannot be changed by args or
# env. list / show / triage / drop / refresh / ingest-vm stay unmatched: they read
# other agents' text or move state, and allowed commands run outside the sandbox.
# Do not widen these to `bash -c` / `bash -lc` prefixes.
prefix_rule(
    pattern = ["dotfiles-feedback", "send"],
    decision = "allow",
    justification = "Queues a feedback item for the owner's private dotfiles repo",
)

prefix_rule(
    pattern = ["dotfiles-feedback", "status"],
    decision = "allow",
    justification = "Shows pending feedback counts without item text",
)

prefix_rule(
    pattern = ["dotfiles-feedback", "flush"],
    decision = "allow",
    justification = "Sends pending feedback items to the fixed private repo",
)

prefix_rule(
    pattern = ["npx", "biome"],
    decision = "allow",
    justification = "Biome linting/formatting is always safe",
)

prefix_rule(
    pattern = ["npx", "oxlint"],
    decision = "allow",
    justification = "Oxlint is always safe",
)

prefix_rule(
    pattern = ["npx", "shellcheck"],
    decision = "allow",
    justification = "Shellcheck is always safe",
)

prefix_rule(
    pattern = ["npx", "oxfmt"],
    decision = "allow",
    justification = "Oxfmt formatting is always safe",
)

# === Allow: package metadata and lockfile installs ===

prefix_rule(
    pattern = ["npm", "view"],
    decision = "allow",
    justification = "Read-only registry metadata lookup",
)

prefix_rule(
    pattern = ["bun", "install", "--frozen-lockfile", "--ignore-scripts"],
    decision = "allow",
    justification = "Installs exactly what the lockfile pins without running lifecycle scripts",
)

# === Allow: read-only git commands ===

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git status",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only git log",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git diff",
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Read-only git show",
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "Read-only git rev-parse",
)

prefix_rule(
    pattern = ["git", "branch"],
    decision = "allow",
    justification = "Read-only git branch listing",
)

prefix_rule(
    pattern = ["git", "remote"],
    decision = "allow",
    justification = "Read-only git remote listing",
)

prefix_rule(
    pattern = ["git", "ls-files"],
    decision = "allow",
    justification = "Read-only file listing from git index",
)

# === Allow: test runner ===

prefix_rule(
    pattern = ["node", "--test"],
    decision = "allow",
    justification = "Running tests with node:test is safe",
)

# === Allow: runtime manager (read-only) ===

prefix_rule(
    pattern = ["mise", "list"],
    decision = "allow",
    justification = "Read-only runtime listing",
)

prefix_rule(
    pattern = ["mise", "which"],
    decision = "allow",
    justification = "Read-only command path resolution",
)

# === Allow: chezmoi (read-only) ===

prefix_rule(
    pattern = ["chezmoi", "status"],
    decision = "allow",
    justification = "Read-only chezmoi status",
)

prefix_rule(
    pattern = ["chezmoi", "diff"],
    decision = "allow",
    justification = "Read-only chezmoi diff",
)

prefix_rule(
    pattern = ["chezmoi", "data"],
    decision = "allow",
    justification = "Read-only chezmoi template data",
)
