{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [{
          "type": "command",
          "command": "bun {{ .chezmoi.homeDir }}/.claude/hooks/implementations/japanese-document-gate.ts",
          "timeout": 10,
          "statusMessage": "Japanese documents: record changes and check publication"
        }]
      },
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun {{ .chezmoi.homeDir }}/.claude/hooks/implementations/codex-learnings-trigger.ts",
            "timeout": 5,
            "statusMessage": "agent-learnings: scene learnings"
          }
        ]
      }
    ],
    "PostToolUse": [{
      "matcher": "^(Bash|apply_patch|Write|Edit|MultiEdit)$",
      "hooks": [{
        "type": "command",
        "command": "bun {{ .chezmoi.homeDir }}/.claude/hooks/implementations/japanese-document-gate.ts",
        "timeout": 10,
        "statusMessage": "Japanese documents: detect unchecked changes"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "bun {{ .chezmoi.homeDir }}/.claude/hooks/implementations/japanese-document-gate.ts",
        "timeout": 10,
        "statusMessage": "Japanese documents: verify current checks and decisions"
      }]
    }]
  }
}
