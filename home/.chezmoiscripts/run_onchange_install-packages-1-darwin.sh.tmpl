{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# packages.yaml taps hash: {{ .packages.darwin.taps | toJson | sha256sum }}
# packages.yaml brews hash: {{ .packages.darwin.brews | toJson | sha256sum }}
# packages.yaml casks hash: {{ .packages.darwin.casks | toJson | sha256sum }}

xcode-select --install || :

if brew --version; then
  echo "brew already installed"
else
  # https://brew.sh/index_ja.html
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -f /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

brew bundle --verbose --file=- <<EOF
{{ range .packages.darwin.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

# Expose only timeout from coreutils; keep BSD tools first on PATH (AI writes BSD-style flags on macOS)
if command -v gtimeout >/dev/null 2>&1; then
  if [ -L "$HOME/.local/bin/timeout" ] || [ ! -e "$HOME/.local/bin/timeout" ]; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$(command -v gtimeout)" "$HOME/.local/bin/timeout" # also repairs a dangling link
  fi
fi

if command -v starship >/dev/null 2>&1; then
  echo "starship is already installed"
else
  echo "install starship"
  curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir ~/.local/bin
fi

{{ end -}}
