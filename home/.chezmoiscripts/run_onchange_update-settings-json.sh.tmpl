{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
# shellcheck disable=SC2088 # tilde used in human-readable echo messages, not paths
# Update ~/.claude/settings.json by merging chezmoi template changes
# enabledPlugins is managed by claude plugin CLI, existing values are preserved
#
# Hash は「スクリプトが実際に消費する入力」を宣言する。第 3 項は下の
# HOOKS_CONTENT でランタイム描画される結果であり、ソースのバイト列ではない。
# include のままだと chezmoi データ (only_private 等) が変わってもハッシュが
# 動かず、再実行されないまま settings.json が古い状態で残る。
#
# 制約: .settings.hooks.json.tmpl に副作用を持つ template function
# (onepassword / exec / output / secret) を入れないこと。includeTemplate は
# chezmoi status / diff でも評価されるため、dry-run で秘密取得や外部コマンド
# 実行が走るようになる。
# Hash: {{ includeTemplate "dot_claude/.settings.base.json.tmpl" . | sha256sum }}{{ includeTemplate "dot_claude/.settings.permissions.json" . | sha256sum }}{{ includeTemplate "dot_claude/.settings.hooks.json.tmpl" . | sha256sum }}{{ include (print .chezmoi.sourceDir "/dot_claude/skill-approvals.md") | sha256sum }}{{ include (print .chezmoi.workingTree "/scripts/skill-inventory.sh") | sha256sum }}{{ include (print .chezmoi.sourceDir "/.chezmoiexternal.toml.tmpl") | sha256sum }}{{ glob (print .chezmoi.workingTree "/.skills/*") }}{{ glob (print .chezmoi.sourceDir "/dot_claude/commands/*.md") }}{{ glob (print .chezmoi.homeDir "/.local/share/private-skills/*") }}{{ $apmLock := print .chezmoi.homeDir "/.apm/apm.lock.yaml" }}{{ with stat $apmLock }}{{ if not .isDir }}{{ include $apmLock | sha256sum }}{{ end }}{{ end }}{{ $allowMarker := print .chezmoi.homeDir "/.claude/.skill-allow-failed" }}{{ with stat $allowMarker }}{{ if not .isDir }}{{ include $allowMarker | sha256sum }}{{ end }}{{ end }}
#
# 上の第 4 項以降は skill-inventory.sh allow の入力 (Skill(...) 許可の計算元)。
# skill-approvals.md・inventory スクリプト・供給源の一覧 (.skills / commands /
# private-skills の glob、apm lock の内容) が動いたら再実行する。
# ~/.claude/.skill-allow-failed は、allow が失敗して前回の Skill 許可を据え置いた
# ことを示す marker (ADR-0017 K5)。その中身 (at=) を Hash に入れることで、fail-soft の
# exit 0 でハッシュが記録されても、失敗が続く間は次の apply でも再実行される (K2 の趣旨)。
# 復旧した apply が marker を消すと Hash は marker 無しの値に戻る。

set -euo pipefail

TARGET_FILE="$HOME/.claude/settings.json"
TEMP_FILE=$(mktemp)
BACKUP_FILE="${TARGET_FILE}.backup.$(date +%Y%m%d_%H%M%S)"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"

{{ template "record-provisioning-failure.sh" . }}

# Skill(...) allow entries come from scripts/skill-inventory.sh (checklist md +
# supplier directories). This script runs before ~/.claude is deployed, so a
# hard failure here would abort every later placement (the defect ADR-0017
# prevents). It therefore fails soft, an exception to K4 limited to this stage:
# keep the Skill(...) entries already in settings.json, record a marker, and
# let run_after_zz-verify-provisioning make the apply exit non-zero.
SKILL_MARKER="$HOME/.claude/.skill-allow-failed"
SKILL_REASON="skill-inventory-allow-failed"
SKILL_RECOVER="bash {{ .chezmoi.workingTree }}/scripts/skill-inventory.sh allow (same arguments as this settings step), fix the reported error, then chezmoi apply"

if ! SKILL_NAMES=$(bash "{{ .chezmoi.workingTree }}/scripts/skill-inventory.sh" allow \
    --md "{{ .chezmoi.sourceDir }}/dot_claude/skill-approvals.md" \
    --self-skills-dir "{{ .chezmoi.workingTree }}/.skills" \
    --commands-dir "{{ .chezmoi.sourceDir }}/dot_claude/commands" \
    --private-dir "$HOME/.local/share/private-skills" \
    --apm-lock "$HOME/.apm/apm.lock.yaml" \
    --chezmoi-external "{{ .chezmoi.sourceDir }}/.chezmoiexternal.toml.tmpl"); then
    echo "WARNING: skill-inventory.sh allow failed; keeping the existing Skill(...) permissions in ~/.claude/settings.json" >&2
    SKILL_ENTRIES=$(jq '[.permissions.allow[]? | select(type == "string" and startswith("Skill("))]' "$TARGET_FILE" 2>/dev/null || echo '[]')
    mkdir -p "$HOME/.claude" 2>/dev/null || true
    if ! record_provisioning_failure "$SKILL_MARKER" "$SKILL_REASON" "$SKILL_RECOVER"; then
        echo "WARNING: could not record the failure at $SKILL_MARKER; fix write permission on ~/.claude and run chezmoi apply" >&2
    fi
else
    SKILL_ENTRIES=$(printf '%s' "$SKILL_NAMES" | jq -c 'map("Skill(\(.))")')
    if [[ -e "$SKILL_MARKER" ]] && ! rm -f "$SKILL_MARKER" 2>/dev/null; then
        echo "WARNING: could not clear stale $SKILL_MARKER; remove it by hand" >&2
    fi
fi

# Read component files
BASE_CONTENT=$(chezmoi execute-template < "${SOURCE_DIR}/dot_claude/.settings.base.json.tmpl")
# Static allow list first, then Skill(<name>) entries; duplicates dropped, order kept.
PERMISSIONS_CONTENT=$(jq --argjson skills "$SKILL_ENTRIES" '
  .allow = (((.allow // []) + $skills) | reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end))
' "${SOURCE_DIR}/dot_claude/.settings.permissions.json")

# Process hooks template with chezmoi
HOOKS_CONTENT=$(chezmoi execute-template < "${SOURCE_DIR}/dot_claude/.settings.hooks.json.tmpl")

# Every command hook runs through hook-timer.sh so per-hook wall-clock time
# lands in ~/.claude/logs/hook-timing.jsonl. Wrapping here, not in the tmpl,
# keeps new hooks from escaping measurement. A trailing `|| exit 2` is
# repeated outside the wrapper so a missing/crashing timer still blocks.
HOOKS_CONTENT=$(printf '%s' "$HOOKS_CONTENT" | jq --arg timer "{{ .chezmoi.homeDir }}/.claude/hooks/hook-timer.sh" '
  with_entries(.key as $ev | .value |= map(.hooks |= map(
    if .type == "command" then
      .command = "sh \($timer | @sh) \($ev | @sh) \(if .async then 1 else 0 end) \(.command | @sh)"
        + (if (.command | test("\\|\\|\\s*exit 2\\s*$")) then " || exit 2" else "" end)
    else . end)))')

# Merge all components into template
TEMPLATE_CONTENT=$(jq -n \
    --argjson base "$BASE_CONTENT" \
    --argjson permissions "$PERMISSIONS_CONTENT" \
    --argjson hooks "$HOOKS_CONTENT" \
    '$base + {"permissions": $permissions, "hooks": $hooks}')

# Check if target file exists
if [[ ! -f "$TARGET_FILE" ]]; then
    echo "Creating new ~/.claude/settings.json..."
    mkdir -p "$(dirname "$TARGET_FILE")"
    # enabledPlugins will be populated by claude plugin install
    echo "$TEMPLATE_CONTENT" | jq '.' > "$TARGET_FILE"
    echo "~/.claude/settings.json created successfully"
    exit 0
fi

# Validate existing file is valid JSON
if ! jq empty "$TARGET_FILE" 2>/dev/null; then
    echo "Warning: Existing ~/.claude/settings.json is not valid JSON"
    echo "Creating backup at $BACKUP_FILE"
    cp "$TARGET_FILE" "$BACKUP_FILE"
    echo "Replacing with template content..."
    echo "$TEMPLATE_CONTENT" | jq '.' > "$TARGET_FILE"
    echo "~/.claude/settings.json replaced successfully"
    exit 0
fi

# Validate template content is valid JSON
if ! echo "$TEMPLATE_CONTENT" | jq empty 2>/dev/null; then
    echo "Error: Template content is not valid JSON"
    exit 1
fi

# Create backup
cp "$TARGET_FILE" "$BACKUP_FILE"

# Extract enabledPlugins from existing file (managed by claude plugin CLI)
EXISTING_PLUGINS=$(jq '.enabledPlugins // {}' "$TARGET_FILE")

# Merge JSONs using jq
# Strategy:
# - permissions: use template value (dotfiles managed)
# - hooks: use template value (dotfiles managed)
# - statusLine: use template value (dotfiles managed)
# - alwaysThinkingEnabled: use template value (dotfiles managed)
# - enabledPlugins: preserve existing values (managed by claude plugin CLI)
# - All other fields in base: use template value
# - Keys absent from the template: preserve existing values.
#   Claude Code writes its own runtime state here (preferredNotifChannel,
#   remoteControlAtStartup など). `$template` で丸ごと置換するとユーザーが
#   アプリ内で切り替えた設定が apply のたびに黙って消えるため、テンプレートが
#   宣言していないキーは残す。副作用として、base からキーを削除しても
#   デプロイ済みファイルからは自動削除されない (手動削除が必要)。
jq --argjson template "$TEMPLATE_CONTENT" --argjson plugins "$EXISTING_PLUGINS" '
    . + $template + {"enabledPlugins": $plugins}
' "$TARGET_FILE" > "$TEMP_FILE"

# Check if there are actual changes
if diff -q "$TARGET_FILE" "$TEMP_FILE" >/dev/null 2>&1; then
    echo "No changes to ~/.claude/settings.json"
    rm "$TEMP_FILE"
    rm "$BACKUP_FILE"
    exit 0
fi

# Show what's changing
echo "Updating ~/.claude/settings.json..."
echo "Changes:"
diff <(jq -S '.' "$TARGET_FILE" 2>/dev/null) \
     <(jq -S '.' "$TEMP_FILE") | head -50 || true

# Update file
mv "$TEMP_FILE" "$TARGET_FILE"

# Cleanup old backup if update successful
if [[ -f "$TARGET_FILE" ]] && jq empty "$TARGET_FILE" 2>/dev/null; then
    rm "$BACKUP_FILE"
    echo "~/.claude/settings.json updated successfully"
else
    echo "Error: Update may have failed. Backup preserved at $BACKUP_FILE"
    exit 1
fi
{{ end -}}
