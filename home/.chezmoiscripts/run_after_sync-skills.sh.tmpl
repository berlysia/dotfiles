{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Sync .skills to ~/.claude/skills and ~/.codex/skills

set -euo pipefail

SKILLS_SOURCE="{{ .chezmoi.workingTree }}/.skills"
PRIVATE_SKILLS_SOURCE="$HOME/.local/share/private-skills"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="$HOME/.codex/skills"
GEMINI_SKILLS="$HOME/.gemini/config/skills"

# Create directories if they don't exist
mkdir -p "$CLAUDE_SKILLS" "$CODEX_SKILLS" "$GEMINI_SKILLS"

# Sync .skills to ~/.claude/skills, ~/.codex/skills, and ~/.gemini/config/skills
echo "Syncing handcrafted skills from .skills..."

# Build exclude filter for APM-managed skills (read directly from lockfile)
EXCLUDE_ARGS=()
if [ -f "$HOME/.apm/apm.lock.yaml" ]; then
  while IFS= read -r skill_name; do
    [ -n "$skill_name" ] && EXCLUDE_ARGS+=(--exclude="$skill_name")
  done < <(grep '^  - \.claude/skills/' "$HOME/.apm/apm.lock.yaml" | sed 's|^  - \.claude/skills/||')
fi

# A name in both the apm lock and .skills is excluded above, so the handcrafted
# copy is silently never deployed (e.g. a machine that has not yet run
# `apm uninstall -g` after a skill moved from apm to .skills). Warn when that
# actually happens, with the recovery step as a greppable `recover:` field.
# Each lock entry lists its deployed top-level skill dirs; `virtual_path` gives
# the declaration to uninstall. Bundles have none, so they get the fixed text.
if [ -f "$HOME/.apm/apm.lock.yaml" ]; then
  while IFS=$'\t' read -r skill_name declaration; do
    [ -d "$SKILLS_SOURCE/$skill_name" ] || continue
    if [ -n "$declaration" ]; then
      recover="apm uninstall -g $declaration"
    else
      recover="remove it from ~/.apm/apm.lock.yaml with apm uninstall -g"
    fi
    echo "WARNING: skill '$skill_name' is in both .skills and the apm lock; the .skills copy is not synced. recover: $recover" >&2
  done < <(awk '
    function flush(  i) { for (i = 1; i <= n; i++) print names[i] "\t" decl; n = 0 }
    /^- repo_url: / { flush(); decl = ""; repo = substr($0, 13); next }
    /^  virtual_path: / { decl = repo "/" substr($0, 17); next }
    /^  - \.claude\/skills\/[^\/]+$/ { names[++n] = substr($0, 20) }
    END { flush() }
  ' "$HOME/.apm/apm.lock.yaml" | sort -u)
fi

# Also exclude private skill names so the --delete pass below doesn't wipe them
PRIVATE_EXCLUDE_ARGS=()
if [ -d "$PRIVATE_SKILLS_SOURCE" ]; then
  for d in "$PRIVATE_SKILLS_SOURCE"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    PRIVATE_EXCLUDE_ARGS+=(--exclude="$name")
  done
fi

# Directories the tools themselves own inside the skills dir. Anchored to the
# destination root so a skill that happens to contain e.g. `synced/` is still synced.
# - ui-skills: managed by chezmoi external
# - claude-recall: Claude Code plugin placed by chezmoi external
# - .system: Codex built-in skills
# - synced / .trash: Claude Code's synced (org/Anthropic-provided) skills and its
#   rotation of previous copies; --delete would otherwise wipe them on every apply
TOOL_OWNED_EXCLUDE_ARGS=(--exclude="/ui-skills" --exclude="/claude-recall" --exclude="/.system" --exclude="/synced" --exclude="/.trash")

# Sync with --delete, but preserve external/private/tool-owned skills.
# --no-perms --executability: git records only the executable bit, so that is
# the only mode the source owns. Plain -a (--perms) would also copy .skills/'s
# directory mode onto the destination root, which chezmoi manages as the parent
# of its externals; a mismatch stops the next apply with "has changed since
# chezmoi last wrote it?". Group/other bits of synced entries follow the umask.
rsync -a --no-perms --executability --delete "${TOOL_OWNED_EXCLUDE_ARGS[@]}" ${EXCLUDE_ARGS[@]+"${EXCLUDE_ARGS[@]}"} ${PRIVATE_EXCLUDE_ARGS[@]+"${PRIVATE_EXCLUDE_ARGS[@]}"} "$SKILLS_SOURCE/" "$CLAUDE_SKILLS/"
rsync -a --no-perms --executability --delete "${TOOL_OWNED_EXCLUDE_ARGS[@]}" ${EXCLUDE_ARGS[@]+"${EXCLUDE_ARGS[@]}"} ${PRIVATE_EXCLUDE_ARGS[@]+"${PRIVATE_EXCLUDE_ARGS[@]}"} "$SKILLS_SOURCE/" "$CODEX_SKILLS/"
rsync -a --no-perms --executability --delete "${TOOL_OWNED_EXCLUDE_ARGS[@]}" ${EXCLUDE_ARGS[@]+"${EXCLUDE_ARGS[@]}"} ${PRIVATE_EXCLUDE_ARGS[@]+"${PRIVATE_EXCLUDE_ARGS[@]}"} "$SKILLS_SOURCE/" "$GEMINI_SKILLS/"

# Overlay private skills (sourced from private repo via chezmoi external).
# Use --delete inside each skill dir but keep other skills untouched.
if [ -d "$PRIVATE_SKILLS_SOURCE" ]; then
  echo "Syncing private skills from $PRIVATE_SKILLS_SOURCE..."
  for src in "$PRIVATE_SKILLS_SOURCE"/*/; do
    [ -d "$src" ] || continue
    name=$(basename "$src")
    rsync -a --delete --exclude=".git" "$src" "$CLAUDE_SKILLS/$name/"
    rsync -a --delete --exclude=".git" "$src" "$CODEX_SKILLS/$name/"
    rsync -a --delete --exclude=".git" "$src" "$GEMINI_SKILLS/$name/"
  done
fi

echo "✅ Handcrafted skills synced successfully"
{{ end -}}
