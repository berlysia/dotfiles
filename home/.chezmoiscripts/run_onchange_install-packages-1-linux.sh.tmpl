{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

# packages.yaml hash: {{ .packages.linux.apt | toJson | sha256sum }}

set -euo pipefail

{{ template "run-installer.sh" . }}

# link_debian_name DEBIAN_COMMAND USUAL_NAME: Ubuntu ships bat / fd as batcat / fdfind.
link_debian_name() {
  local src
  if command -v "$2" >/dev/null 2>&1; then
    echo "$2 is already installed"
    return 0
  fi
  if ! src="$(command -v "$1")"; then
    echo "$1 is missing after the apt install" >&2
    return 1
  fi
  echo "create symlink for $2"
  ln -sfn "$src" ~/.local/bin/"$2" # -f replaces a dangling link left by an earlier run
}

sudo apt-get update
sudo apt-get install -y {{ range .packages.linux.apt }} {{.}}{{ end }}

# install mise via official installer
if command -v mise >/dev/null 2>&1; then
  echo "mise is already installed"
else
  echo "install mise"
  run_installer https://mise.run
fi

link_debian_name batcat bat
link_debian_name fdfind fd

if command -v starship >/dev/null 2>&1; then
  echo "starship is already installed"
else
  echo "install starship"
  run_installer https://starship.rs/install.sh --yes --bin-dir ~/.local/bin
fi

{{ end -}}
