{{ if ne .chezmoi.os "windows" }}
[".zsh/ni.zsh"]
type = "file"
url = "https://raw.githubusercontent.com/azu/ni.zsh/main/ni.zsh"
refreshPeriod = "24h"
# fzf is now managed by mise - see ~/.config/mise/config.toml
{{ end }}

{{/* ui-skills: Opinionated constraints for building better interfaces */}}
{{/* Downloaded directly to ~/.claude/skills/, excluded from rsync */}}
[".claude/skills/ui-skills/SKILL.md"]
type = "file"
url = "https://ui-skills.com/llms.txt"
refreshPeriod = "168h" # 1 week

{{ if ne .chezmoi.os "windows" }}
{{/* claude-recall plugin: loads from ~/.claude/skills as claude-recall@skills-dir (no marketplace upstream). */}}
{{/* Excluded from the skills rsync. Its hooks and MCP entry launch `recall`, so the tarball is pinned by */}}
{{/* checksum, and its version must match the binary pinned in mise. Renovate (customManagers in renovate.json) */}}
{{/* rewrites the two lines below together with the mise version in one PR. It stops extracting them if their */}}
{{/* layout changes (tests/agent-vm/run-templates.sh checks the match). Write the version exactly as the upstream */}}
{{/* release tag is spelled, `v` included or not: the URL uses it as is and the guard compares strings. */}}
{{- $recallTool := index (include "dot_config/mise/config.toml" | fromToml).tools "github:babarot/claude-recall" }}
{{- $recallPluginVersion := "v1.12.0" }}
{{- $recallPluginSha256 := "fb340985ddbd5c3eabaf78bd4d44e7c1242e2ab27cfec5436b52752a9e6d2418" }}
{{- if not (and (kindIs "map" $recallTool) (eq (toString (index $recallTool "version")) $recallPluginVersion)) }}
{{-   fail (printf "claude-recall: mise pins %v but the plugin in .chezmoiexternal.toml.tmpl is %s. recovery: Renovate's claude-recall PR should change both this file and the mise entry, so check that the PR has both. If one is missing, keep the mise entry in table form ({ version = ..., bin = \"recall\" }), set $recallPluginVersion to the mise version and $recallPluginSha256 to the claude-recall-plugin.tar.gz line of `gh release download <version> -R babarot/claude-recall -p checksums.txt -O -`" $recallTool $recallPluginVersion) }}
{{- end }}
{{/* stripComponents = 0 relies on home/.chezmoiversion (2.73.2): from 2.73.2 chezmoi ignores the tarball's ./ */}}
{{/* entry, so there is no leading component to strip. Older chezmoi needed 1 (7eb1e5f) and stops with */}}
{{/* "inconsistent state" at 0; 1 on 2.73.2 or later silently drops .mcp.json and misplaces the rest. */}}
[".claude/skills/claude-recall"]
type = "archive"
url = "https://github.com/babarot/claude-recall/releases/download/{{ $recallPluginVersion }}/claude-recall-plugin.tar.gz"
stripComponents = 0
exact = true
checksum.sha256 = "{{ $recallPluginSha256 }}"
{{ end }}

{{/* tla2tools.jar: the TLC model checker that .skills/formal-check runs. Source: the tlaplus/tlaplus release */}}
{{/* asset of the same version. The sha256 below is the value computed from the downloaded file; the upstream */}}
{{/* sha1 matched it as a secondary check (verified 2026-10-24). The reader, .skills/formal-check/scripts/lib/runtime.mjs, */}}
{{/* confirms the version from the TLC banner line (TLC 2.19), so when raising the version, re-check the verdict */}}
{{/* mapping table and version.mjs against upstream and fix them in the same change. No refreshPeriod: once fetched */}}
{{/* the jar is served from chezmoi's cache. A failed fetch or checksum mismatch makes apply exit non-zero, the */}}
{{/* same as the ni.zsh external above. Renovate does not watch this entry (no customManager), so a human raises */}}
{{/* it. tests/agent-vm/run-templates.sh downloads the jar and compares it with this sha256; the agent-vm CI */}}
{{/* job runs it whenever this file changes. The VM and */}}
{{/* Windows get no jar: neither runs the installer or the reader. */}}
{{- $tla2toolsVersion := "v1.7.4" }}
{{- $tla2toolsSha256 := "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88" }}
{{ if ne .chezmoi.os "windows" }}
[".config/formal-check/tla2tools.jar"]
type = "file"
url = "https://github.com/tlaplus/tlaplus/releases/download/{{ $tla2toolsVersion }}/tla2tools.jar"
checksum.sha256 = "{{ $tla2toolsSha256 }}"
{{ end }}

{{/* private-skills: personal canon (berlysia-style, berlysia-slide). */}}
{{/* Cloned via SSH to a holding location, then merged into ~/.claude/skills and */}}
{{/* ~/.codex/skills by run_after_sync-skills.sh. Public dotfiles stays safe. */}}
[".local/share/private-skills"]
type = "git-repo"
url = "git@github.com:berlysia/private-skills.git"
refreshPeriod = "168h" # 1 week
[".local/share/private-skills".pull]
args = ["--ff-only"]

{{/* wsl2-ssh-agent is only needed in WSL2 environment */}}
{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
[".local/bin/wsl2-ssh-agent"]
type = "file"
url = "https://github.com/mame/wsl2-ssh-agent/releases/latest/download/wsl2-ssh-agent"
refreshPeriod = "24h"
executable = true
{{/* wsl-notify-send: installed via run_onchange script to Windows PATH */}}
{{ end }}
