#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Help function
show_help() {
    cat <<'EOF'
git-worktree-create - Create a new git worktree in .git/worktree directory

Usage:
  git-worktree-create [--no-install] <branch-name> [<base>]
  git-worktree-create --help

Description:
  Creates a new git worktree in the .git/worktree directory. The command
  intelligently handles different scenarios:

  - If branch exists locally: Creates worktree from local branch
  - If branch exists on remote: Creates local tracking branch and worktree
  - If branch doesn't exist: Creates new branch from <base>, or from the
    current HEAD when no <base> is given

  For a new branch the start point is shown with its short SHA. When it is a
  local branch that has an upstream and is behind it (as of the last fetch;
  nothing is fetched), a warning on stderr says so and shows how to catch up.
  After creating the worktree, installs its dependencies when the package
  manager is unambiguous and the install cannot rewrite the lockfile:
  packageManager in package.json first, then the lockfile (pnpm and bun:
  install --frozen-lockfile, npm: ci). Success is signalled by the line
  "Dependencies installed". Otherwise the reason and the command to run are
  printed. Nothing is installed for yarn, for a branch that comes from origin
  (review its package.json scripts first), or when no package manager can be
  determined. A failed install does not fail the creation.

Arguments:
  <branch-name>  Name of the branch for the worktree
  <base>         Commit-ish to start a new branch from (default: current HEAD).
                 Used only for a new branch; it is an error when the branch
                 already exists locally or on origin. The new branch has no
                 upstream.

Options:
  --no-install   Do not install dependencies; show the command instead
  --help, -h     Show this help message (at any position)

Examples:
  # Create worktree for existing branch
  git-worktree-create feature-login

  # Create worktree for new branch
  git-worktree-create new-feature

  # Create worktree from remote branch
  git-worktree-create origin-feature

  # Create a new branch from origin/main (run git fetch first)
  git-worktree-create new-feature origin/main

Location:
  Worktrees are created in: <repo-root>/.git/worktree/<branch-name>
  <repo-root> is the main checkout, even when run from inside a linked worktree.
EOF
}

# strip_cntrl <text>: the text without control characters. Branch names, bases and refs come from the caller and are
# echoed in messages; an ESC or CR in them must not reach the terminal. Bytes are removed one by one, so a multibyte
# name stays whole (a UTF-8 locale's 8-bit CSI 0x9b and bidi controls therefore pass; accepted).
strip_cntrl() {
    printf '%s' "$1" | tr -d '[:cntrl:]'
}

# say_warn <message>: a warning on stderr, printed without interpreting backslashes in the message
say_warn() {
    printf '%b⚠️  %s%b\n' "$YELLOW" "$(strip_cntrl "$1")" "$NC" >&2
}

# say_info <color> <message>: a line on stdout, printed without interpreting backslashes in the message
say_info() {
    printf '%b%s%b\n' "$1" "$(strip_cntrl "$2")" "$NC"
}

# say_error <message>: an error line on stdout, printed without interpreting backslashes in the message
say_error() {
    printf '%b%s%b\n' "$RED" "$(strip_cntrl "$1")" "$NC"
}

# resolve_install <dir>: which install the project at <dir> asks for.
# Sets install_pm (empty when package.json names no package manager and no lockfile does), install_cmd (the command
# to run, or to show), install_skip (why this script does not run it itself; empty when it may), and
# install_conflict (the lockfiles found, when two or more package managers have one and package.json names none).
# A wrong package manager rewrites node_modules, so nothing is guessed: no default, no priority among lockfiles.
resolve_install() {
    local dir=$1 declared pm lock found_pms="" found_locks=""
    install_pm=""
    install_cmd=()
    install_skip=""
    install_conflict=""
    [[ -f "$dir/package.json" ]] || return 0
    # One sed and no pipe: under pipefail, a reader that exits early would end this script after the worktree exists
    declared=$(sed -n '/"packageManager"/{s/.*"packageManager"[[:space:]]*:[[:space:]]*"\([a-z]*\)@.*/\1/p;q;}' "$dir/package.json") || declared=""
    for lock in pnpm:pnpm-lock.yaml bun:bun.lock bun:bun.lockb npm:package-lock.json npm:npm-shrinkwrap.json yarn:yarn.lock; do
        pm=${lock%%:*}
        lock=${lock#*:}
        [[ -f "$dir/$lock" ]] || continue
        found_locks="${found_locks:+$found_locks, }$lock"
        case " $found_pms " in *" $pm "*) ;; *) found_pms="${found_pms:+$found_pms }$pm" ;; esac
    done
    case "$declared" in
    pnpm | bun | npm | yarn) install_pm=$declared ;;
    *)
        case "$found_pms" in
        "") return 0 ;;
        *" "*)
            install_conflict=$found_locks
            return 0
            ;;
        *) install_pm=$found_pms ;;
        esac
        ;;
    esac
    case " $found_pms " in
    *" $install_pm "*) ;;
    *)
        install_cmd=("$install_pm" install)
        install_skip="$install_pm has no lockfile here, and an install would write one"
        return 0
        ;;
    esac
    case "$install_pm" in
    pnpm | bun) install_cmd=("$install_pm" install --frozen-lockfile) ;;
    npm) install_cmd=(npm ci) ;;
    yarn)
        # The flag that keeps the lockfile differs between yarn 1 and later versions, and Plug'n'Play writes outside
        # node_modules, where the agent-vm mount does not reach
        install_cmd=(yarn install)
        install_skip="yarn is not run automatically"
        ;;
    esac
}

# install_dependencies: install what the new worktree asks for, or say why not and what to run.
# Reads worktree_path, repo_root, install_deps, branch_source, deps_target. Never fails: the worktree exists.
install_dependencies() {
    local wt_q cmd_text skip pm_path status=0
    resolve_install "$worktree_path"
    [[ -n "$install_pm$install_conflict" ]] || return 0
    wt_q=$(printf '%q' "$worktree_path")
    case "$deps_target" in
    attach-failed) return 0 ;; # the attach warning already says not to install and how to recover
    no-helper)
        say_warn "dependencies are not installed in $wt_q (agent-vm-node-modules is missing, so node_modules here is shared with the host); recreate the machine from the host: agent-vm rm $(printf '%q' "$repo_root")"
        return 0
        ;;
    esac
    if [[ -n "$install_conflict" ]]; then
        say_warn "dependencies are not installed in $wt_q (found $install_conflict and no packageManager field in package.json); install with the project's package manager"
        return 0
    fi
    cmd_text="${install_cmd[*]}"
    skip=$install_skip
    if [[ "$install_deps" != true ]]; then
        skip="--no-install"
    elif [[ "$branch_source" == remote ]]; then
        # Code this checkout has not had before: its package.json scripts are not run by a command that does not look
        # like an install
        skip="not run automatically because the branch comes from origin; an install runs the scripts of its package.json, so review them first"
    fi
    if [[ -n "$skip" ]]; then
        say_info "$BLUE" "💡 Dependencies are not installed ($skip). To install them: cd $wt_q && $cmd_text"
        return 0
    fi
    # Resolved before the cd, and only to an absolute path: a relative PATH entry must not pick a file of the branch
    pm_path=$(command -v "$install_pm") || pm_path=""
    case "$pm_path" in
    /*) ;;
    *)
        say_warn "dependencies are not installed in $wt_q ($install_pm is not on PATH). Once it is: cd $wt_q && $cmd_text"
        return 0
        ;;
    esac
    say_info "$BLUE" "📦 Installing dependencies: $cmd_text"
    (cd "$worktree_path" && "$pm_path" "${install_cmd[@]:1}" </dev/null) || status=$?
    if [[ $status -eq 0 ]]; then
        say_info "$GREEN" "✓ Dependencies installed"
    else
        say_warn "dependencies are not installed in $wt_q ($cmd_text: status $status); the worktree itself is created. To retry: cd $wt_q && $cmd_text"
    fi
}

install_deps=true
positional=()
if [[ $# -eq 0 ]]; then
    say_error "Error: Branch name is required"
    echo
    show_help
    exit 1
fi
# The word "help" is the help command only as the first argument, as before
if [[ "$1" == "help" ]]; then
    show_help
    exit 0
fi
# Only collects here: --help and unknown options are decided as they are met, so that the count of positional
# arguments is checked after them
while [[ $# -gt 0 ]]; do
    case "$1" in
    --help | -h)
        show_help
        exit 0
        ;;
    --no-install) install_deps=false ;;
    -*)
        say_error "Error: Unknown option: $1"
        echo
        show_help
        exit 1
        ;;
    *) positional+=("$1") ;;
    esac
    shift
done
if [[ ${#positional[@]} -eq 0 ]]; then
    say_error "Error: Branch name is required"
    echo
    show_help
    exit 1
fi
branch_name=${positional[0]}
base=${positional[1]-}

# Anchor on the common git dir so that running from inside a linked worktree
# (whose .git is a file) still creates the worktree under the main
# repository's .git/worktree/.
# --path-format needs git 2.31; git-worktree-cleanup already requires 2.36.
if ! common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    say_error "✗ Not inside a git repository, or git is older than 2.31 (git rev-parse --path-format)"
    exit 1
fi
worktrees_dir="$common_dir/worktree"
# The main checkout, which owns .git/worktree/ and the agent-vm machine.
repo_root=$(dirname "$common_dir")

# Every check of the input comes before anything is created, .git/worktree included.
if [[ ${#positional[@]} -gt 2 ]]; then
    say_error "Error: Too many arguments: ${positional[2]}"
    echo
    show_help
    exit 1
fi
# The name becomes a path under .git/worktree, so a name that is not a ref (a/../x) must not get that far.
# `--branch` alone is not used: it expands @{-1} to the previous branch and accepts it. refs/heads/HEAD passes the
# first check but is not usable as a branch, which only `--branch` rejects.
if ! git check-ref-format "refs/heads/$branch_name" >/dev/null 2>&1 || ! git check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    say_error "Error: Not a valid branch name: $branch_name"
    exit 1
fi
if [[ -n "$base" ]]; then
    # A base for a branch that already exists would be dropped silently (or would need a reset of existing work)
    for existing_ref in "refs/heads/$branch_name" "refs/remotes/origin/$branch_name"; do
        if git show-ref --verify --quiet "$existing_ref"; then
            say_error "Error: Branch '$branch_name' already exists ($existing_ref); $base is used only for a new branch"
            exit 1
        fi
    done
    # The resolved SHA is what worktree add receives, so the value checked is the value used and the caller's string
    # never becomes an argument of it
    if ! base_sha=$(git rev-parse --verify --quiet --end-of-options "$base^{commit}" 2>/dev/null); then
        say_error "Error: Not a commit: $base"
        exit 1
    fi
fi

# Set worktree path
worktree_path="$worktrees_dir/$branch_name"

# Check if worktree already exists
if [[ -d "$worktree_path" ]]; then
    say_error "✗ Worktree already exists: $worktree_path"
    exit 1
fi

# Create .git/worktree directory if it doesn't exist
if [[ ! -d "$worktrees_dir" ]]; then
    echo -e "${BLUE}📁 Creating .git/worktree directory...${NC}"
    mkdir -p "$worktrees_dir"
fi

# For a new branch: how far its start point is behind its upstream (empty when not compared)
behind_count=""
ahead_count=""
start_branch=""
upstream_name=""
upstream_ref=""

# Check if branch exists locally
if git show-ref --verify --quiet "refs/heads/$branch_name"; then
    echo -e "${GREEN}✓ Branch '$branch_name' exists locally${NC}"
    branch_source=local
    git worktree add "$worktree_path" "$branch_name"
elif git show-ref --verify --quiet "refs/remotes/origin/$branch_name"; then
    # Branch exists on remote but not locally
    echo -e "${YELLOW}⚠️  Branch '$branch_name' exists on remote, creating local tracking branch${NC}"
    branch_source=remote
    git worktree add "$worktree_path" -b "$branch_name" "origin/$branch_name"
else
    # Branch doesn't exist, create new branch from the base or the current HEAD
    branch_source=new
    # Only a local branch is compared with its upstream: a remote-tracking ref, a tag, a SHA and a detached HEAD have
    # none, and nothing is fetched or guessed (origin/<name> is not assumed to be the upstream). Every git call that
    # judges this has its stderr dropped and its failure absorbed: it is advice, and a broken upstream or a tag and
    # a branch of one name (ambiguous) must neither stop the creation nor leak a git error.
    start_ref=$(git rev-parse --symbolic-full-name "${base:-HEAD}" 2>/dev/null) || start_ref=""
    if [[ "$start_ref" == refs/heads/* ]]; then
        # @{upstream} rejects the refs/heads/ form (fatal: no such branch), so it gets the name that form carries
        start_branch=${start_ref#refs/heads/}
        upstream_ref=$(git rev-parse --symbolic-full-name "$start_branch@{upstream}" 2>/dev/null) || upstream_ref=""
        if [[ -n "$upstream_ref" ]]; then
            upstream_name=$(git rev-parse --abbrev-ref "$start_branch@{upstream}" 2>/dev/null) || upstream_name=""
            behind_count=$(git rev-list --count "$start_ref..$upstream_ref" 2>/dev/null) || behind_count=""
            ahead_count=$(git rev-list --count "$upstream_ref..$start_ref" 2>/dev/null) || ahead_count=""
        fi
    fi
    if [[ -n "$base" ]]; then
        start_name=$base
    else
        start_name=$(git branch --show-current)
        start_name=${start_name:-detached HEAD}
    fi
    start_short=$(git rev-parse --short "${base_sha:-HEAD}" 2>/dev/null) || start_short="no commits"
    start_note=""
    if [[ "$behind_count" =~ ^[1-9][0-9]*$ ]]; then
        if [[ "$ahead_count" =~ ^[1-9][0-9]*$ ]]; then
            start_note=", diverged from $upstream_name"
        else
            start_note=", $behind_count behind $upstream_name"
        fi
    fi
    say_info "$BLUE" "📝 Creating new branch '$branch_name' from '$start_name' ($start_short)$start_note"
    if [[ -n "$base" ]]; then
        git worktree add -b "$branch_name" "$worktree_path" "$base_sha"
    else
        git worktree add "$worktree_path" -b "$branch_name"
    fi
fi

echo -e "${GREEN}✓ Worktree created: $worktree_path${NC}"
# Before the path and the install, so that a caller that is cut off while the install runs has seen it
if [[ "$behind_count" =~ ^[1-9][0-9]*$ ]]; then
    if [[ "$ahead_count" =~ ^[1-9][0-9]*$ ]]; then
        say_warn "'$start_branch' has diverged from $upstream_name (as of the last fetch)"
    else
        # --ff-only fixes the new worktree's branch only (the main checkout's branch is not moved), and changes
        # nothing when the branch has diverged
        say_warn "'$start_branch' is $behind_count commit(s) behind $upstream_name (as of the last fetch); to catch up: git -C $(printf '%q' "$worktree_path") merge --ff-only $(printf '%q' "$upstream_ref")"
    fi
fi
# Before the install: a caller that is cut off while it runs still has the path
say_info "$BLUE" "💡 To switch to this worktree: cd $(printf '%q' "$worktree_path")"
# Whether an install in the new worktree lands in its own node_modules: "yes", "attach-failed" (warned below), or
# "no-helper" (inside a machine whose node_modules is still the host's).
deps_target=yes
# agent-vm (docs/decisions/0022-agent-vm-node-modules.md): inside a machine, the new worktree gets its VM-local
# node_modules now rather than at the next launch, and the install runs after that so it lands in the VM-local one; on
# the host, the install comes first: the sync makes a running machine create its mount points in this tree, and an
# install that recreates node_modules afterwards would remove them. Neither stops the creation: the worktree is
# there, only its node_modules may still be shared or empty.
if [[ -e "${AGENT_VM_MARKER:-/etc/agent-vm}" ]]; then
    if command -v agent-vm-node-modules >/dev/null 2>&1; then
        nm_status=0
        agent-vm-node-modules attach "$worktree_path" >/dev/null || nm_status=$?
        if [[ $nm_status -ne 0 ]]; then
            # An install there now would put linux packages into the host's worktree
            nm_wt=$(printf '%q' "$worktree_path")
            say_warn "node_modules of $nm_wt may be shared with the host (agent-vm-node-modules attach: status $nm_status); do not install there until this succeeds: agent-vm-node-modules attach $nm_wt"
            deps_target=attach-failed
        fi
    else
        deps_target=no-helper
    fi
    install_dependencies
else
    install_dependencies
    if command -v agent-vm >/dev/null 2>&1; then
        nm_status=0
        agent-vm node-modules-sync "$repo_root" || nm_status=$?
        if [[ $nm_status -ne 0 ]]; then
            say_warn "the running agent-vm machine may not have VM-local node_modules for $(printf '%q' "$worktree_path") yet (agent-vm node-modules-sync: status $nm_status); the next agent-vm launch syncs it"
        fi
    fi
fi
