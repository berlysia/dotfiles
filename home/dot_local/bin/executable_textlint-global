#!/usr/bin/env bash
# Global textlint: runs the textlint installed in ~/.config/textlint with the
# .textlintrc.json deployed there, from any directory.
#
# Kept as a standalone file (not a symlink) so PATH lookup yields a stable name
# for Bash(textlint-global *) permission matching, same as workflow-cli.
#
# Usage:
#   textlint-global FILE...                 lint files
#   textlint-global - [--stdin-filename N]  lint stdin (default filename: stdin.md)
#   textlint-global --text "文章"           lint the given string as markdown
#   textlint-global --config C ...          use another config instead of the global one
# Every other argument is passed through to textlint unchanged.
#
# TEXTLINT_HOME overrides the runtime directory (used to test against a
# scratch install). It is honoured as-is, so never invoke this wrapper from a
# path where untrusted input can set environment variables. The "Recover with"
# command always targets the default location (~/.config/textlint), the only
# one chezmoi manages, so under an override it will not fix the override.
set -euo pipefail

TEXTLINT_HOME="${TEXTLINT_HOME:-$HOME/.config/textlint}"
TEXTLINT_BIN="$TEXTLINT_HOME/node_modules/.bin/textlint"
TEXTLINT_CONFIG="$TEXTLINT_HOME/.textlintrc.json"
STATE_FILE="$TEXTLINT_HOME/.install-state"
# Printed with a literal "~" so the user's own shell expands it.
RECOVER="chezmoi apply ~/.config/textlint ~/.chezmoiscripts/10-install-textlint-deps.sh"

if [[ ! -x "$TEXTLINT_BIN" ]]; then
    echo "textlint: runtime not installed at $TEXTLINT_HOME" >&2
    echo "Recover with: $RECOVER" >&2
    exit 2
fi

# Stale runtime: package.json was redeployed but the last install of it did
# not succeed (the installer copies package.json to .install-state only on
# success; run_after_10-install-textlint-deps.sh.tmpl is its only writer).
# Recovery is running that installer (RECOVER); a manual bun install does not
# write the state, so it would leave the warning in place.
# Any mismatch, a missing state or a failed read counts as stale. Without cmp
# the state is unknown rather than stale, so that case gets its own warning.
# The checks run inside `if` conditions so that no failure in them, including a
# missing cmp, stops textlint from running; they only decide whether to warn.
if [[ -f "$TEXTLINT_HOME/package.json" ]]; then
    if ! command -v cmp >/dev/null 2>&1; then
        echo "textlint: WARNING cannot check the runtime at $TEXTLINT_HOME against its package.json: cmp is not on PATH" >&2
        echo "Fix: put cmp (diffutils) on PATH" >&2
    elif ! cmp -s "$TEXTLINT_HOME/package.json" "$STATE_FILE" 2>/dev/null; then
        echo "textlint: WARNING runtime at $TEXTLINT_HOME is older than its package.json" >&2
        echo "Recover with: $RECOVER" >&2
    fi
fi

args=()
text=""
use_stdin=false
has_config=false
has_stdin_filename=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --text)
            if [[ $# -lt 2 ]]; then
                echo "textlint: --text requires an argument" >&2
                exit 2
            fi
            text="$2"
            use_stdin=true
            shift 2
            ;;
        --text=*)
            text="${1#--text=}"
            use_stdin=true
            shift
            ;;
        -)
            use_stdin=true
            shift
            ;;
        --stdin)
            use_stdin=true
            shift
            ;;
        --config|-c|--config=*)
            has_config=true
            args+=("$1")
            shift
            ;;
        --stdin-filename|--stdin-filename=*)
            has_stdin_filename=true
            args+=("$1")
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

if [[ "$has_config" == false ]]; then
    args=(--config "$TEXTLINT_CONFIG" "${args[@]+"${args[@]}"}")
fi

if [[ "$use_stdin" == true ]]; then
    args+=(--stdin)
    if [[ "$has_stdin_filename" == false ]]; then
        args+=(--stdin-filename stdin.md)
    fi
    if [[ -n "$text" ]]; then
        # Not `exec` here: exec on the right side of a pipe only replaces the
        # forked subshell, and control would fall through to the next exec
        # and run textlint a second time on the real stdin.
        printf '%s\n' "$text" | "$TEXTLINT_BIN" "${args[@]}"
        exit $?
    fi
    exec "$TEXTLINT_BIN" "${args[@]}"
fi

if [[ ${#args[@]} -eq 2 && -t 0 ]]; then
    # Only the injected --config remains: nothing to lint. Show textlint's own
    # help instead of its "no files" error.
    exec "$TEXTLINT_BIN" --help
fi

exec "$TEXTLINT_BIN" "${args[@]}"
