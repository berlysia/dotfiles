#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Help function
show_help() {
    cat <<'EOF'
git-worktree-cleanup - Remove git worktrees whose work is finished

Usage:
  git-worktree-cleanup [--yes | --non-interactive] [--discard-tmp=<id>]... [--] [<worktree-path | branch>...]
  git-worktree-cleanup --help

Description:
  Fetches origin, then classifies each worktree and removes the ones whose work
  is safely finished. Without arguments it scans only worktrees under
  <repo>/.git/worktree/. Worktrees outside .git/worktree are removed only when named as a target.
  A target is a worktree path or a branch name. If any target cannot be resolved,
  nothing is removed. Branches are not deleted.

  Always kept:
  - locked (git worktree lock)
  - in use: the current directory of one of your processes is inside it
  - uncommitted or untracked changes
  - ahead of its origin/<branch>

  Removed without asking:
  - merged into the origin main branch (ancestor, rebase merge or squash merge)

  Asked (on a terminal; otherwise kept, except where --discard-tmp answers):
  - commits are all on origin but the branch is not detected as merged
    (--yes answers these)
  - commits exist that are not on origin (--yes does not answer these)
  - files in .tmp/ or .entire/ (--yes does not answer these). When the worktree is
    merged and its tip was made in it (a commit, a rebase, or a merge commit on top
    of one), the files and an id are printed, and --discard-tmp=<id> answers for it
  - no commits since the worktree was created (--yes does not answer these)
  - it cannot be checked whether the worktree is in use (--yes does not answer these)

Options:
  --yes, -y              Answer the questions that --yes may answer with "yes"
  --non-interactive, -n  Never ask; keep every worktree that would be asked about
                         (default when stdin is not a TTY)
  --discard-tmp=<id>     Answer "yes" for the named target whose listed files in .tmp/ or
                         .entire/ have this id. The id is printed with the list and changes
                         when the files change. Needs at least one target; may be repeated.
                         Works with --yes and --non-interactive, and when fetching fails.
                         Use it after someone has decided the listed files are not needed.
  --help, -h             Show this help message

  --yes answers only the questions about worktrees whose commits are all on origin but not detected as merged. Worktrees with commits not on origin, with files in .tmp/ or .entire/, with no commits since the worktree was created, or that cannot be checked for use, are asked only on a terminal and are kept by --yes.
  When fetching origin fails, --yes removes nothing more than --non-interactive.

Exit codes:
  0  Done. When scanning, worktrees that were kept are normal.
  1  Usage error (including --discard-tmp without a target or with a malformed id),
     a target that cannot be resolved, or the main worktree named as a target.
  2  A target was given and at least one worktree was kept (the reason is printed),
     including when git refused to remove it or, inside an agent-vm machine, when
     its VM-local node_modules could not be detached.

Examples:
  # From the main worktree: remove only the worktree of your own branch
  git-worktree-cleanup my-branch

  # Unattended: remove what is merged, keep everything else
  git-worktree-cleanup --non-interactive

Note:
  - Assumes the remote is named origin.
  - The main worktree is never removed.
  - Detecting merged branches writes one dangling commit object per worktree
    (no ref is moved; git gc removes it).
  - The in-use check sees only the current directory of your own processes.
    A session started in the main worktree that works in another worktree by
    absolute path is not seen, and neither are other users' processes. Clean up
    your own worktree from the main worktree with: git-worktree-cleanup <branch>
EOF
}

# How confirmation prompts are answered: ask | yes | no
answer_mode=ask
# Ids given with --discard-tmp=<id>; each one answers for the worktree whose listed files have that id
discard_ids=()
targets=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --yes|-y)
            answer_mode=yes
            ;;
        --non-interactive|-n)
            answer_mode=no
            ;;
        --discard-tmp=*)
            discard_id=${1#--discard-tmp=}
            # 12 is TMP_ID_LEN, which is defined with describe_tmp below.
            if [[ ! "$discard_id" =~ ^[0-9a-f]{12}$ ]]; then
                printf '%b%s%b\n' "$RED" "--discard-tmp needs the id printed with the worktree's file list: $1" "$NC" >&2
                echo "Run 'git-worktree-cleanup --help' for usage." >&2
                exit 1
            fi
            discard_ids+=("$discard_id")
            ;;
        --)
            shift
            while [[ $# -gt 0 ]]; do
                targets+=("$1")
                shift
            done
            break
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}" >&2
            echo "Run 'git-worktree-cleanup --help' for usage." >&2
            exit 1
            ;;
        *)
            targets+=("$1")
            ;;
    esac
    shift
done

# Someone answered about particular worktrees, so an id never applies to a scan.
if [[ ${#discard_ids[@]} -gt 0 && ${#targets[@]} -eq 0 ]]; then
    printf '%b%s%b\n' "$RED" "--discard-tmp needs the worktrees named as targets" "$NC" >&2
    echo "Run 'git-worktree-cleanup --help' for usage." >&2
    exit 1
fi

# Without a terminal, read would hit EOF and abort the script under set -e,
# so fall back to the safe answer.
if [[ "$answer_mode" == ask ]] && [[ ! -t 0 ]]; then
    answer_mode=no
fi

# say <color> <message>: print without interpreting backslashes in the message
say() {
    printf '%b%s%b\n' "$1" "$2" "$NC"
}

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    say "$RED" "✗ Not inside a git repository"
    exit 1
fi
# -z needs git 2.36; without it the porcelain output could not be split safely.
if ! git worktree list --porcelain -z >/dev/null 2>&1; then
    say "$RED" "✗ git 2.36 or later is required (git worktree list -z)"
    exit 1
fi

echo "🔍 Checking git worktrees..."

# Parallel arrays describing every worktree; index 0 is the main worktree.
wt_path=()
wt_head=()
wt_branch=()
wt_locked=()
wt_phys=()
wt_missing=()
wt_count=0

cur_path=""
cur_head=""
cur_branch=""
cur_locked=0
cur_have=0

push_entry() {
    if [[ $cur_have -eq 1 ]]; then
        wt_path[wt_count]=$cur_path
        wt_head[wt_count]=$cur_head
        wt_branch[wt_count]=$cur_branch
        wt_locked[wt_count]=$cur_locked
        wt_count=$((wt_count + 1))
    fi
    cur_path=""
    cur_head=""
    cur_branch=""
    cur_locked=0
    cur_have=0
}

while IFS= read -r -d '' field; do
    case "$field" in
        "")
            push_entry
            ;;
        "worktree "*)
            cur_path=${field#worktree }
            cur_have=1
            ;;
        "HEAD "*)
            cur_head=${field#HEAD }
            ;;
        "branch "*)
            cur_branch=${field#branch }
            cur_branch=${cur_branch#refs/heads/}
            ;;
        locked|"locked "*)
            cur_locked=1
            ;;
    esac
done < <(git worktree list --porcelain -z)
push_entry

main_worktree=${wt_path[0]}

for ((i = 0; i < wt_count; i++)); do
    if [[ -d "${wt_path[$i]}" ]] && phys=$(cd -P -- "${wt_path[$i]}" 2>/dev/null && pwd -P); then
        wt_phys[i]=$phys
        wt_missing[i]=0
    else
        wt_phys[i]=""
        wt_missing[i]=1
    fi
done
main_phys=${wt_phys[0]}

# Inside an agent-vm machine, each worktree under .git/worktree carries VM-local node_modules mounts
# (docs/decisions/0022-agent-vm-node-modules.md). git alone would empty the VM-local copy and then fail on the
# mountpoint, so the helper detaches, runs the removal, and deletes or re-attaches the copy under its lock.
nm_helper=0
if [[ -e "${AGENT_VM_MARKER:-/etc/agent-vm}" ]] && command -v agent-vm-node-modules >/dev/null 2>&1; then
    nm_helper=1
fi
# remove_worktree <index>: git worktree remove, through the helper where it owns mounts; output goes to the caller.
# The helper's own statuses (64 refused, 70 failed, 71 lock) are its EXIT_USAGE / EXIT_RM_FAILED / EXIT_RM_LOCKED in
# agent-vm-node-modules; with any of them it ran nothing. Otherwise it returns the command's status.
remove_worktree() {
    local w=${wt_path[$1]}
    if [[ $nm_helper -eq 1 && "${wt_phys[$1]}" == "$main_phys/.git/worktree/"* ]]; then
        agent-vm-node-modules remove "$w" -- git -C "$main_worktree" worktree remove -- "$w"
    else
        git -C "$main_worktree" worktree remove -- "$w"
    fi
}

# --- fetch ---------------------------------------------------------------------
offline=false
offline_reason=""

# Never prompt for credentials; keep the user's own ssh configuration when they have one.
try_fetch() {
    if [[ -n "${GIT_SSH_COMMAND:-}" ]] || git -C "$main_worktree" config --get core.sshCommand >/dev/null 2>&1; then
        GIT_TERMINAL_PROMPT=0 git -C "$main_worktree" fetch --prune --quiet origin </dev/null >/dev/null 2>&1
    else
        GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" \
            git -C "$main_worktree" fetch --prune --quiet origin </dev/null >/dev/null 2>&1
    fi
}

if ! git -C "$main_worktree" remote get-url origin >/dev/null 2>&1; then
    offline=true
    offline_reason="no origin remote"
elif ! try_fetch; then
    offline=true
    offline_reason="fetch failed"
fi
if [[ "$offline" == true ]]; then
    say "$YELLOW" "⚠️  Could not fetch origin ($offline_reason); remote state may be stale. Unmerged worktrees are kept even with --yes."
fi

# --- main branch ---------------------------------------------------------------
main_ref=""
main_name=""
head_ref=""
if head_ref=$(git -C "$main_worktree" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null) \
    && git -C "$main_worktree" rev-parse --verify --quiet "$head_ref" >/dev/null 2>&1; then
    main_ref=$head_ref
else
    for candidate in refs/remotes/origin/main refs/remotes/origin/master; do
        if git -C "$main_worktree" rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
            main_ref=$candidate
            break
        fi
    done
fi
if [[ -n "$main_ref" ]]; then
    main_name=${main_ref#refs/remotes/origin/}
fi

# --- select the worktrees to process -------------------------------------------
selected=()
outside_count=0
removed=0
kept=0

if [[ ${#targets[@]} -gt 0 ]]; then
    unresolved=0
    for target in "${targets[@]}"; do
        found=-1
        # Compare physical paths; the subshell keeps this script's own cwd where it is.
        if [[ -d "$target" ]] && target_phys=$(cd -P -- "$target" 2>/dev/null && pwd -P); then
            for ((i = 0; i < wt_count; i++)); do
                if [[ -n "${wt_phys[$i]}" && "${wt_phys[$i]}" == "$target_phys" ]]; then
                    found=$i
                    break
                fi
            done
        fi
        if [[ $found -lt 0 ]]; then
            for ((i = 0; i < wt_count; i++)); do
                if [[ -n "${wt_branch[$i]}" && "${wt_branch[$i]}" == "$target" ]]; then
                    found=$i
                    break
                fi
            done
        fi
        if [[ $found -lt 0 ]]; then
            say "$RED" "✗ Not a removable worktree: $target (see 'git worktree list')"
            unresolved=1
        elif [[ $found -eq 0 ]]; then
            say "$RED" "✗ Refusing to remove the main worktree: $target"
            unresolved=1
        else
            already=0
            for chosen in ${selected[@]+"${selected[@]}"}; do
                if [[ "$chosen" == "$found" ]]; then already=1; fi
            done
            if [[ $already -eq 0 ]]; then selected+=("$found"); fi
        fi
    done
    if [[ $unresolved -ne 0 ]]; then
        exit 1
    fi
else
    for ((i = 1; i < wt_count; i++)); do
        if [[ "${wt_missing[$i]}" -eq 1 ]]; then
            selected+=("$i")
        elif [[ "${wt_phys[$i]}" == "$main_phys/.git/worktree/"* ]]; then
            selected+=("$i")
        else
            echo
            echo "📁 ${wt_path[$i]}: outside .git/worktree - skipping"
            outside_count=$((outside_count + 1))
        fi
    done
fi

# --- helpers -------------------------------------------------------------------

# Sets cwd_list (newline separated physical cwds of your processes) and cwd_unknown.
cwd_list=""
cwd_unknown=false
collect_cwds() {
    local p out=""
    cwd_list=""
    cwd_unknown=false
    if [[ -d /proc/self ]]; then
        for p in /proc/[0-9]*/cwd; do
            out+=$(readlink "$p" 2>/dev/null || true)$'\n'
        done
    elif command -v lsof >/dev/null 2>&1; then
        # lsof exits non-zero on mere warnings, so only its output counts. Our own process
        # is always in it, so empty output means the detection itself failed.
        out=$(lsof -a -d cwd -u "$(id -u)" -Fn 2>/dev/null | sed -n 's/^n//p' || true)
        if [[ -z "$out" ]]; then
            cwd_unknown=true
        fi
    else
        cwd_unknown=true
    fi
    cwd_list="$out"$'\n'"$(pwd -P)"
}

is_in_use() {
    local phys=$1 line
    while IFS= read -r line; do
        if [[ -z "$line" ]]; then continue; fi
        if [[ "$line" == "$phys" || "$line" == "$phys/"* ]]; then
            return 0
        fi
    done <<<"$cwd_list"
    return 1
}

# is_merged <sha>: sets merged_how to ancestor | rebase | squash.
# The squash probe writes one dangling commit object (no ref is moved; gc removes it).
merged_how=""
is_merged() {
    local sha=$1 base n c probe
    merged_how=""
    if [[ -z "$main_ref" ]]; then
        return 1
    fi
    if git -C "$main_worktree" merge-base --is-ancestor "$sha" "$main_ref" 2>/dev/null; then
        merged_how=ancestor
        return 0
    fi
    if ! base=$(git -C "$main_worktree" merge-base "$sha" "$main_ref" 2>/dev/null); then
        return 1
    fi
    # With no non-merge commit, git cherry prints nothing and "all lines are -" would hold vacuously.
    if ! n=$(git -C "$main_worktree" rev-list --no-merges --count "$base..$sha" 2>/dev/null); then
        return 1
    fi
    if [[ "$n" -eq 0 ]]; then
        return 1
    fi
    if ! c=$(git -C "$main_worktree" cherry "$main_ref" "$sha" 2>/dev/null); then
        return 1
    fi
    if [[ -n "$c" ]] && ! grep -q '^+' <<<"$c"; then
        merged_how=rebase
        return 0
    fi
    # Squash merge: compare the whole branch, folded into one commit, with main.
    if ! probe=$(GIT_AUTHOR_NAME=git-worktree-cleanup GIT_AUTHOR_EMAIL=git-worktree-cleanup@localhost \
        GIT_COMMITTER_NAME=git-worktree-cleanup GIT_COMMITTER_EMAIL=git-worktree-cleanup@localhost \
        git -C "$main_worktree" commit-tree "$sha^{tree}" -p "$base" -m git-worktree-cleanup-probe 2>/dev/null); then
        return 1
    fi
    if ! c=$(git -C "$main_worktree" cherry "$main_ref" "$probe" 2>/dev/null); then
        return 1
    fi
    case "$c" in
        -*)
            merged_how=squash
            return 0
            ;;
    esac
    return 1
}

# is_fresh <wt> <sha>: the worktree's HEAD never pointed anywhere but <sha> (or the reflog is unreadable).
is_fresh() {
    local wt=$1 sha=$2 log line
    if ! log=$(git -C "$wt" reflog show --format=%H HEAD -- 2>/dev/null); then
        return 0
    fi
    if [[ -z "$log" ]]; then
        return 0
    fi
    while IFS= read -r line; do
        if [[ "$line" != "$sha" ]]; then
            return 1
        fi
    done <<<"$log"
    return 0
}

# tip_made_here <wt>: the current tip was created in this worktree: by a commit, or by a rebase (also through
# git pull) that replayed commits. A merge commit counts when the commit it was merged into was created here
# too; with merge.ff=false, merging someone else's branch into an untouched worktree also makes a merge commit.
# It reads the HEAD reflog, newest first, in runs of entries that left HEAD on the same commit: the oldest entry
# of a run is the one that brought HEAD there. A fast-forward, a reset, a checkout or a cherry-pick means the
# tip came from elsewhere, and so does an unreadable or expired reflog. A heuristic: it tells how the tip
# arrived, not whose commits it holds.
tip_made_here() {
    local log line sha prev="" how=""
    local made='^(commit|(rebase|pull[^:]*) (-i )?\((pick|reword|edit|squash|fixup|continue)\):)'
    local joined='^merge .*: Merge made by '
    if ! log=$(git -C "$1" reflog show --format='%H %gs' HEAD -- 2>/dev/null) || [[ -z "$log" ]]; then
        return 1
    fi
    while IFS= read -r line; do
        sha=${line%% *}
        if [[ -n "$prev" && "$sha" != "$prev" ]]; then
            if [[ "$how" =~ $made ]]; then
                return 0
            fi
            # After a merge commit, go on to the run before it: HEAD as it was when the merge was made.
            if [[ ! "$how" =~ $joined ]]; then
                return 1
            fi
        fi
        prev=$sha
        how=${line#* }
    done <<<"$log"
    [[ "$how" =~ $made ]]
}

# What removing an ASK_TMP worktree discards; set by describe_tmp, emptied by every classify.
tmp_files=""  # ignored files under .tmp/ and .entire/, one per line
tmp_others="" # other ignored paths, as git status folds them (node_modules/, .env, ...)
tmp_id=""     # TMP_ID_LEN hex digits over the worktree path, branch, tip and both lists
TMP_ID_LEN=12
# describe_tmp <wt> <phys> <branch> <sha>: fills the three variables; fails when git cannot list the files.
describe_tmp() {
    local wt=$1 phys=$2 br=$3 sha=$4 all id
    if ! tmp_files=$(git -C "$wt" -c core.quotePath=false ls-files --others --ignored --exclude-standard -- .tmp .entire 2>/dev/null) \
        || [[ -z "$tmp_files" ]] \
        || ! all=$(git -C "$wt" -c core.quotePath=false status --porcelain --ignored --untracked-files=normal 2>/dev/null); then
        tmp_files=""
        return 1
    fi
    # git quotes a path with special characters, so the two directories can follow a double quote.
    tmp_others=$(sed -n 's/^!! //p' <<<"$all" | grep -v -e '^"\{0,1\}\.tmp/' -e '^"\{0,1\}\.entire/' || true)
    if ! id=$(printf '%s\n%s\n%s\n%s\n%s\n' "$phys" "$br" "$sha" "$tmp_files" "$tmp_others" | git -C "$wt" hash-object --stdin 2>/dev/null); then
        tmp_files=""
        tmp_others=""
        return 1
    fi
    tmp_id=${id:0:TMP_ID_LEN}
}
# print_capped <lines>: the first 20 lines and how many more there are. Every line starts with "| ", and a
# name with blanks is shell-quoted, so that a file name cannot pass for a line of this script's own output.
print_capped() {
    local n line shown=0
    n=$(grep -c '' <<<"$1")
    while IFS= read -r line && [[ $shown -lt 20 ]]; do
        if [[ "$line" == *[[:space:]]* ]]; then
            printf -v line '%q' "$line"
        fi
        printf '     | %s\n' "$line"
        shown=$((shown + 1))
    done <<<"$1"
    if [[ "$n" -gt 20 ]]; then
        echo "     ... and $((n - 20)) more"
    fi
}
print_tmp_files() {
    echo "   $(grep -c '' <<<"$tmp_files") ignored files in .tmp/ or .entire/ (id $tmp_id):"
    print_capped "$tmp_files"
    if [[ -n "$tmp_others" ]]; then
        echo "   other ignored paths that go with the worktree:"
        print_capped "$tmp_others"
    fi
}

# id_given <id>: the id was passed with --discard-tmp
id_given() {
    local id
    for id in ${discard_ids[@]+"${discard_ids[@]}"}; do
        if [[ "$id" == "$1" ]]; then
            return 0
        fi
    done
    return 1
}

# classify <index> <sha>: sets verdict (KEEP | REMOVE | ASK | ASK_TMP | ASK_HUMAN) and reason.
# The first matching stage decides; a failing git command falls to that stage's conservative verdict.
verdict=""
reason=""
classify() {
    local i=$1 sha=$2
    local wt=${wt_path[$i]} br=${wt_branch[$i]} phys=${wt_phys[$i]}
    local st ig a u hint
    tmp_files=""
    tmp_others=""
    tmp_id=""

    if [[ "${wt_locked[$i]}" -eq 1 ]]; then
        verdict=KEEP; reason="locked"; return 0
    fi
    if is_in_use "$phys"; then
        verdict=KEEP; reason="in use by a running process (or the current directory)"; return 0
    fi
    if ! st=$(git -C "$wt" status --porcelain 2>/dev/null); then
        verdict=KEEP; reason="git status failed"; return 0
    fi
    if [[ -n "$st" ]]; then
        verdict=KEEP; reason="uncommitted changes"; return 0
    fi
    if [[ -n "$br" ]] && git -C "$wt" rev-parse --verify --quiet "refs/remotes/origin/$br" >/dev/null 2>&1; then
        if ! a=$(git -C "$wt" rev-list --count "refs/remotes/origin/$br..$sha" 2>/dev/null); then
            verdict=KEEP; reason="cannot compare with origin/$br"; return 0
        fi
        if [[ "$a" -gt 0 ]]; then
            verdict=KEEP; reason="ahead of origin/$br by $a commits"; return 0
        fi
    fi
    if [[ "$cwd_unknown" == true ]]; then
        verdict=ASK_HUMAN; reason="cannot detect whether it is in use"; return 0
    fi
    # --untracked-files=normal: with status.showUntrackedFiles=no git would list no ignored files at all.
    if ! ig=$(git -C "$wt" status --porcelain --ignored --untracked-files=normal -- .tmp .entire 2>/dev/null); then
        verdict=ASK_HUMAN; reason="cannot inspect .tmp/ and .entire/"; return 0
    fi
    if grep -q '^!! ' <<<"$ig"; then
        verdict=ASK_HUMAN; reason="has ignored files in .tmp/ or .entire/"
        if is_merged "$sha"; then
            # ASK_TMP: without the ignored files this would be REMOVE, and the merged tip is this worktree's own work.
            # "merged" alone does not show that: a worktree fast-forwarded to main, or to someone else's branch
            # that was merged later, holds nothing of its own but an uncommitted plan.
            if is_fresh "$wt" "$sha"; then
                reason="$reason (merged: $merged_how); check them, then answer y on a terminal or move them and re-run"
            elif ! tip_made_here "$wt"; then
                reason="$reason (merged: $merged_how), but its tip was not made in this worktree; check them, then answer y on a terminal or move them and re-run"
            elif describe_tmp "$wt" "$phys" "$br" "$sha"; then
                verdict=ASK_TMP
                printf -v hint '%q' "${br:-$wt}"
                reason="$reason (merged: $merged_how); check them, then answer y on a terminal, re-run with --discard-tmp=$tmp_id $hint, or move them and re-run"
            else
                reason="$reason (merged: $merged_how); check them, then answer y on a terminal or move them and re-run"
            fi
        fi
        return 0
    fi
    if is_fresh "$wt" "$sha"; then
        verdict=ASK_HUMAN; reason="no commits since the worktree was created"; return 0
    fi
    if is_merged "$sha"; then
        verdict=REMOVE; reason="merged into $main_name ($merged_how)"; return 0
    fi
    if ! u=$(git -C "$wt" rev-list --count "$sha" --not --remotes=origin 2>/dev/null); then
        verdict=ASK_HUMAN; reason="cannot count commits not on origin"; return 0
    fi
    if [[ "$u" -gt 0 ]]; then
        verdict=ASK_HUMAN; reason="$u commits not on origin"; return 0
    fi
    verdict=ASK
    if [[ -z "$main_ref" ]]; then
        reason="no origin main branch to compare with"
    elif [[ -z "$br" ]]; then
        reason="detached HEAD, not merged into $main_name"
    else
        reason="pushed but not merged into $main_name"
    fi
    return 0
}

# confirm_delete <verdict> [<tmp id>]: return 0 when deletion is confirmed
confirm_delete() {
    local kind=$1 id=${2:-}
    # Offline too: like REMOVE, a newer origin main still contains what the stale one contains.
    if [[ "$kind" == ASK_TMP ]] && id_given "$id"; then
        echo "Delete anyway? (y/N) y [--discard-tmp=$id]"
        return 0
    fi
    if [[ "$kind" == ASK_TMP && ${#discard_ids[@]} -gt 0 ]]; then
        echo "Delete anyway? (y/N) n [no --discard-tmp id matches this list; the files changed or the id is another worktree's] - skipping"
        return 1
    fi
    case "$answer_mode" in
        yes)
            if [[ "$kind" == ASK && "$offline" != true ]]; then
                echo "Delete anyway? (y/N) y [--yes]"
                return 0
            fi
            if [[ "$kind" == ASK ]]; then
                echo "Delete anyway? (y/N) n [--yes, offline] - skipping"
            elif [[ "$kind" == ASK_TMP ]]; then
                echo "Delete anyway? (y/N) n [--yes does not answer this; see the --discard-tmp command above] - skipping"
            else
                echo "Delete anyway? (y/N) n [--yes does not answer this; run it on a terminal] - skipping"
            fi
            return 1
            ;;
        no)
            echo "Delete anyway? (y/N) n [non-interactive] - skipping"
            return 1
            ;;
    esac
    local reply=""
    read -p "Delete anyway? (y/N) " -n 1 -r reply || true
    echo
    [[ $reply =~ ^[Yy]$ ]]
}

# --- main loop -----------------------------------------------------------------
collect_cwds

for i in ${selected[@]+"${selected[@]}"}; do
    worktree=${wt_path[$i]}
    printf '\n📁 Checking worktree: %s\n' "$worktree"

    if [[ "${wt_missing[$i]}" -eq 1 ]]; then
        say "$YELLOW" "⚠️  directory not found - leaving it to 'git worktree prune'"
        kept=$((kept + 1))
        continue
    fi

    first_sha=${wt_head[$i]}
    classify "$i" "$first_sha"
    first_verdict=$verdict
    first_tmp_id=$tmp_id

    case "$verdict" in
        KEEP)
            say "$RED" "✗ $reason - skipping"
            kept=$((kept + 1))
            continue
            ;;
        REMOVE)
            say "$GREEN" "✓ $reason"
            ;;
        *)
            say "$YELLOW" "⚠️  $reason"
            if [[ "$verdict" == ASK_TMP ]]; then
                print_tmp_files
            fi
            if ! confirm_delete "$verdict" "$tmp_id"; then
                kept=$((kept + 1))
                continue
            fi
            ;;
    esac

    # A prompt can wait for minutes; other sessions may have used the worktree meanwhile.
    collect_cwds
    if ! now_sha=$(git -C "$worktree" rev-parse HEAD 2>/dev/null); then
        now_sha=""
    fi
    classify "$i" "${now_sha:-$first_sha}"
    # For ASK_TMP the answer was about one list of files; a different list is a different question.
    if [[ "$now_sha" != "$first_sha" ]] || { [[ "$verdict" != "$first_verdict" ]] && [[ "$verdict" != REMOVE ]]; } \
        || { [[ "$verdict" == ASK_TMP ]] && [[ "$tmp_id" != "$first_tmp_id" ]]; }; then
        say "$RED" "✗ state changed since the check - skipping"
        kept=$((kept + 1))
        continue
    fi

    rm_status=0
    err=$(remove_worktree "$i" 2>&1) || rm_status=$?
    if [[ $rm_status -ne 0 ]]; then
        # 64, 70 and 71 come only from the helper (git uses 0, 1 and 128); the helper ran nothing for them
        case "$nm_helper:$rm_status" in
            1:64) say "$RED" "✗ the node_modules helper refused it: $err - skipping" ;;
            1:70) say "$RED" "✗ could not detach its VM-local node_modules: $err - skipping" ;;
            1:71) say "$RED" "✗ another node_modules sync held the lock (try again): $err - skipping" ;;
            *) say "$RED" "✗ git refused to remove it: $err - skipping" ;;
        esac
        kept=$((kept + 1))
        continue
    fi
    # The helper also warns after a removal (a store it could not delete, a copy it re-attached). Without the helper
    # the output stays discarded on success, as before.
    if [[ $nm_helper -eq 1 && -n "$err" ]]; then
        say "$YELLOW" "⚠️  $err"
    fi
    say "$GREEN" "✓ Removing worktree: $worktree"
    removed=$((removed + 1))
done

if [[ $removed -gt 0 ]]; then
    echo -e "\n🧹 Pruning worktree list..."
    git -C "$main_worktree" worktree prune
fi

echo -e "\nRemoved $removed, kept $kept, outside .git/worktree $outside_count."

if [[ ${#targets[@]} -gt 0 && $kept -gt 0 ]]; then
    exit 2
fi
exit 0
