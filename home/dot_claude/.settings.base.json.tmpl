{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bun {{ .chezmoi.homeDir }}/.claude/node_modules/ccstatusline/dist/ccstatusline.js ${ANTHROPIC_BASE_URL:+${ANTHROPIC_AUTH_TOKEN:+--config {{ .chezmoi.homeDir }}/.config/ccstatusline/settings.gateway.json}}",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "plansDirectory": "./.claude/plans",
  "language": "japanese",
  "autoMemoryEnabled": false,
  "defaultMode": "auto",
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "0"
  },
  "deniedMcpServers": [
    { "serverName": "plugin:compound-engineering:context7" }
  ]
}
