{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bun {{ .chezmoi.homeDir }}/.claude/node_modules/ccstatusline/dist/ccstatusline.js ${ANTHROPIC_BASE_URL:+${ANTHROPIC_AUTH_TOKEN:+--config {{ .chezmoi.homeDir }}/.config/ccstatusline/settings.gateway.json}}",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "plansDirectory": "./.claude/plans",
  "language": "japanese",
  "autoMemoryEnabled": false,
  "defaultMode": "auto",
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "0",
    "CLAUDE_VOICE_ENABLED": "false"
    {{- if ne .chezmoi.os "windows" }}
    {{- $modsDir := print .chezmoi.homeDir "/" (includeTemplate "claude-mods-dir" . | trim) }}
    {{- $names := includeTemplate "claude-mod-names" (dict "root" (print .chezmoi.workingTree "/mods")) | splitList " " | compact }}
    {{- if $names }},
    "CLAUDE_CODE_PLUGIN_DIRS": {{ $dirs := list }}{{ range $names }}{{ $dirs = append $dirs (print $modsDir "/" .) }}{{ end }}{{ join ":" $dirs | toJson }}
    {{- end }}
    {{- end }}
  },
  "deniedMcpServers": [
    { "serverName": "plugin:compound-engineering:context7" }
  ]
}
