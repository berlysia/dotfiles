{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "providers": {
    // Default model is left untouched so delegation runs (-m zai-coding-plan/...) keep their behavior.
    // Select with: opencode -m sarashina/sarashina3.2-mini-thinking
    // The key is stored by `opencode auth login`; no key is read from the environment here.
    "sarashina": {
      "name": "Sarashina API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.sarashina.ai/v1",
      },
      "compatibility": {
        "maxTokensField": "max_completion_tokens",
        "streamUsage": false,
      },
      "body": {
        "tool_choice": "auto",
      },
      "models": {
        "sarashina3.2-mini-thinking": {
          "name": "Sarashina3.2 mini thinking",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
            },
          },
          "limit": {
            "context": 128000,
            "output": 8000,
          },
          "body": {
            "reasoning_effort": "medium",
          },
          "compatibility": {
            "reasoningField": "reasoning",
            "requireReasoning": false,
          },
        },
      },
    },
  },
  // Agents used by `delegation offload`. Permissions are an allowlist: the
  // leading "*": "deny" is overridden only by the entries after it. The deny
  // lists mirror READ_DENY / EDIT_DENY in delegation/offload.ts (a test keeps
  // them equal). grep is denied because it bypasses the read deny.
  "agent": {
    "worktree-read": {
      "description": "Read-only agent for delegations that leave the machine",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          ".git": "deny",
          "**/.git": "deny",
          ".git/**": "deny",
          "**/.git/**": "deny",
          ".tmp/**": "deny",
          "**/.tmp/**": "deny",
          "node_modules/**": "deny",
          "**/node_modules/**": "deny",
          ".env": "deny",
          "**/.env": "deny",
          ".env.*": "deny",
          "**/.env.*": "deny",
          "*.env": "deny",
          "**/*.env": "deny",
          ".envrc": "deny",
          "**/.envrc": "deny",
          ".dev.vars": "deny",
          "**/.dev.vars": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "*.p12": "deny",
          "**/*.p12": "deny",
          "*.pfx": "deny",
          "**/*.pfx": "deny",
          "*.jks": "deny",
          "**/*.jks": "deny",
          "*.keystore": "deny",
          "**/*.keystore": "deny",
          "id_rsa*": "deny",
          "**/id_rsa*": "deny",
          "id_ed25519*": "deny",
          "**/id_ed25519*": "deny",
          ".npmrc": "deny",
          "**/.npmrc": "deny",
          ".pypirc": "deny",
          "**/.pypirc": "deny",
          ".netrc": "deny",
          "**/.netrc": "deny",
          ".git-credentials": "deny",
          "**/.git-credentials": "deny",
          "credentials*": "deny",
          "**/credentials*": "deny",
          "service-account*.json": "deny",
          "**/service-account*.json": "deny",
          "*.tfvars": "deny",
          "**/*.tfvars": "deny",
          "*.tfstate": "deny",
          "**/*.tfstate": "deny",
          "secrets/**": "deny",
          "**/secrets/**": "deny",
          ".ssh/**": "deny",
          "**/.ssh/**": "deny",
          ".aws/**": "deny",
          "**/.aws/**": "deny",
          ".kube/**": "deny",
          "**/.kube/**": "deny",
          ".gnupg/**": "deny",
          "**/.gnupg/**": "deny",
          ".docker/config.json": "deny",
          "**/.docker/config.json": "deny",
          ".mcp.json": "deny",
          "**/.mcp.json": "deny",
          ".claude/**": "deny",
          "**/.claude/**": "deny",
          ".codex/**": "deny",
          "**/.codex/**": "deny",
        },
        "glob": "allow",
        "list": "allow",
        "grep": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "task": "deny",
        "skill": "deny",
        "opencode_*": "deny",
        "external_directory": "deny",
      },
    },
    "worktree-edit": {
      "description": "Read and edit agent for delegations that leave the machine",
