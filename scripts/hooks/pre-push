#!/bin/bash
# Git pre-push hook
# - GitHub Actions workflow lint with jactionlint
# - Secret detection with gitleaks (full repository scan)

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

if [ "${SKIP_HOOKS:-}" = "1" ]; then
    echo -e "${YELLOW}⚠ Hooks skipped (SKIP_HOOKS=1)${NC}"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
EXIT_CODE=0

#
# 1. GitHub Actions Check (jactionlint)
#
if [ -d "${REPO_ROOT}/.github/workflows" ]; then
    WORKFLOW_COUNT=$(find "${REPO_ROOT}/.github/workflows" -type f \( -name "*.yml" -o -name "*.yaml" \) | wc -l)

    if [ "$WORKFLOW_COUNT" -gt 0 ]; then
        echo -e "${BLUE}⚡ Checking GitHub Actions workflows with jactionlint...${NC}"
        if command -v jactionlint &> /dev/null; then
            # Worktrees live under the main checkout's .git/, and config discovery
            # can pick up the main checkout's jactionlint.yaml, so pass --config-file.
            # The checked directory is the repository, not the cwd, hence the cd.
            if (cd "${REPO_ROOT}" && jactionlint --config-file "${REPO_ROOT}/.github/jactionlint.yaml"); then
                echo -e "${GREEN}✓ All workflows passed jactionlint checks${NC}"
            else
                echo -e "${RED}❌ jactionlint found issues in workflows${NC}"
                EXIT_CODE=1
            fi
        else
            echo -e "${YELLOW}⚠ jactionlint not installed, skipping workflow check${NC}"
            echo -e "${YELLOW}  Install: mise install${NC}"
        fi
    fi
fi

echo

#
# 2. Secret Detection (gitleaks)
#
echo -e "${BLUE}🔍 Scanning repository for secrets before push...${NC}"
if command -v gitleaks &> /dev/null; then
    if ! gitleaks detect --config "${REPO_ROOT}/.gitleaks.toml" --verbose; then
        echo -e "${RED}❌ Secrets detected in repository history!${NC}"
        echo -e "${YELLOW}   Use 'git rebase -i' to fix commits with secrets.${NC}"
        EXIT_CODE=1
    else
        echo -e "${GREEN}✓ No secrets found${NC}"
    fi
else
    echo -e "${YELLOW}⚠ gitleaks not installed, skipping secret detection${NC}"
fi

exit "$EXIT_CODE"
