#!/bin/bash
# Git pre-commit hook
# - Secret detection with gitleaks
# - Hook tests when hook files are modified

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Skip if requested
if [ "${SKIP_HOOKS:-}" = "1" ]; then
    echo -e "${YELLOW}⚠ Hooks skipped (SKIP_HOOKS=1)${NC}"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
EXIT_CODE=0

#
# 1. Secret Detection (gitleaks)
#
echo -e "${BLUE}🔍 Checking for secrets...${NC}"
if command -v gitleaks &> /dev/null; then
    if ! gitleaks protect --staged --config "${REPO_ROOT}/.gitleaks.toml" --verbose; then
        echo -e "${RED}❌ Secrets detected! Remove them before committing.${NC}"
        echo -e "${YELLOW}   If false positive: update .gitleaks.toml or .gitleaksignore${NC}"
        EXIT_CODE=1
    else
        echo -e "${GREEN}✓ No secrets found${NC}"
    fi
else
    echo -e "${YELLOW}⚠ gitleaks not installed, skipping secret detection${NC}"
    echo -e "${YELLOW}  Install: mise install gitleaks${NC}"
fi

echo

#
# 2. Formatting (oxfmt) & Linting (oxlint)
#
STAGED_ALL_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

# 2a. Format via the package.json script (single source of truth)
#
# 対象ファイル集合とフォーマッタのフラグをここで再定義してはならない。
# かつては `--ignore-path .oxfmtignore` を欠いた独自の oxfmt 呼び出しをしており、
# CI の format:check と対象が 17 ファイルずれた結果、その隙間に整形違反が
# 入り込んだ (.skills/japanese-tech-writing/SKILL.md)。prettier が担当する
# yml/yaml に至っては commit 時に一度も検査されていなかった。
#
# リポジトリ全体を整形することで、staged 以外の経路で混入した違反や
# フォーマッタのバージョン更新による drift も同じ commit で解消される
# (staged 限定の整形では、一度入った違反は永久に検知されない)。
echo -e "${BLUE}🎨 Formatting (bun run format)...${NC}"
if command -v bun &> /dev/null; then
    if ! FORMAT_OUTPUT=$(bun run format 2>&1); then
        echo -e "${RED}❌ format failed${NC}"
        echo "$FORMAT_OUTPUT" | tail -20
        EXIT_CODE=1
    else
        # 整形結果のうち、元々 staged だったファイルのみ再 stage する
        for file in $STAGED_ALL_FILES; do
            if [ -f "$file" ]; then
                git add "$file"
            fi
        done

        # staged 外に整形差分が出たなら握りつぶさず知らせる
        UNSTAGED_FMT=$(git diff --name-only || true)
        if [ -n "$UNSTAGED_FMT" ]; then
            echo -e "${YELLOW}⚠ staged 外のファイルも整形されました (別途 commit してください):${NC}"
            echo "$UNSTAGED_FMT" | sed 's/^/    /'
        fi
        echo -e "${GREEN}✓ Repository formatted${NC}"
    fi
else
    echo -e "${RED}❌ bun not found; formatting cannot be verified${NC}"
    echo -e "${YELLOW}  Install: mise install (bypass with SKIP_HOOKS=1)${NC}"
    EXIT_CODE=1
fi

echo

# 2b. Lint via the package.json script (single source of truth)
#
# 2a と同じ理由で、対象ファイル集合と ignore パターンをここで再定義しない。
# 独自呼び出しは `--ignore-pattern 'node_modules/'` を欠いており、実行系も
# npx (レジストリ解決) と CI の bun (pinned devDependency) で分かれていた。
# staged 限定をやめリポジトリ全体を対象にするのは 2a と同じ理由で、
# 全体でも 1 秒未満で完了する。
echo -e "${BLUE}🦊 Linting (bun run lint:oxlint)...${NC}"
if command -v bun &> /dev/null; then
    if ! LINT_OUTPUT=$(bun run lint:oxlint 2>&1); then
        echo -e "${RED}❌ oxlint found issues${NC}"
        # oxlint は warning でも大量に出力するため、commit を止めた error 行を
        # 明示的に拾う。error が無い失敗 (oxlint 自体の異常終了) は末尾を出す
        LINT_ERRORS=$(echo "$LINT_OUTPUT" | grep -E ': error ' || true)
        if [ -n "$LINT_ERRORS" ]; then
            echo "$LINT_ERRORS" | head -20
        else
            echo "$LINT_OUTPUT" | tail -20
        fi
        EXIT_CODE=1
    else
        echo -e "${GREEN}✓ Repository passed oxlint checks${NC}"
    fi
else
    echo -e "${RED}❌ bun not found; lint cannot be verified${NC}"
    echo -e "${YELLOW}  Install: mise install (bypass with SKIP_HOOKS=1)${NC}"
    EXIT_CODE=1
fi

echo

#
# 3. Shell Script Linting (shellcheck)
#
STAGED_SH_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)
# Also check staged executable scripts without .sh extension (e.g., executable_*)
STAGED_EXEC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)executable_' || true)
ALL_SHELL_FILES=$(echo -e "${STAGED_SH_FILES}\n${STAGED_EXEC_FILES}" | sort -u | grep -v '^$' || true)
if [ -n "$ALL_SHELL_FILES" ]; then
    echo -e "${BLUE}🐚 Checking shell scripts with shellcheck...${NC}"
    if command -v shellcheck &> /dev/null; then
        SHELLCHECK_FAILED=false
        for file in $ALL_SHELL_FILES; do
            if [ -f "$file" ]; then
                echo "  Checking: $file"
                if ! shellcheck --severity=warning "$file"; then
                    SHELLCHECK_FAILED=true
                fi
            fi
        done

        if [ "$SHELLCHECK_FAILED" = true ]; then
            echo -e "${RED}❌ shellcheck found issues in staged files${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ All staged shell scripts passed shellcheck${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ shellcheck not installed, skipping${NC}"
        echo -e "${YELLOW}  Install: apt install shellcheck${NC}"
    fi
else
    echo -e "${GREEN}✓ No shell scripts staged${NC}"
fi

echo

#
# 4. Codex Config Format Check
#
STAGED_CODEX_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'home/dot_codex/\.config\.toml|scripts/(check|format)-codex-config\.sh' || true)
if [ -n "$STAGED_CODEX_FILES" ]; then
    echo -e "${BLUE}⚙️  Checking Codex config format...${NC}"
    CHECK_SCRIPT="${REPO_ROOT}/scripts/check-codex-config.sh"

    if [ -f "$CHECK_SCRIPT" ]; then
        if [ -f "${REPO_ROOT}/home/dot_codex/.config.toml" ]; then
            if "$CHECK_SCRIPT"; then
                echo -e "${GREEN}✓ Codex config is properly formatted${NC}"
            else
                echo -e "${RED}❌ Codex config needs formatting${NC}"
                echo -e "${YELLOW}  Run: ./scripts/format-codex-config.sh${NC}"
                EXIT_CODE=1
            fi
        else
            echo -e "${YELLOW}⚠ home/dot_codex/.config.toml not found, skipping${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Check script not found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No Codex config files staged${NC}"
fi

echo

#
# 4.5. Codex Execution Policy Check
#
STAGED_RULES_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'home/dot_codex/rules/' || true)
if [ -n "$STAGED_RULES_FILES" ]; then
    echo -e "${BLUE}📋 Checking Codex execution policy rules...${NC}"
    if command -v codex &> /dev/null; then
        RULES_FAILED=false
        for file in $STAGED_RULES_FILES; do
            if [ -f "$file" ]; then
                echo "  Checking: $file"
                if ! codex execpolicy check "$file" 2>&1; then
                    RULES_FAILED=true
                fi
            fi
        done

        if [ "$RULES_FAILED" = true ]; then
            echo -e "${RED}❌ Codex execution policy check failed${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ All execution policy rules are valid${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ codex not installed, skipping execution policy check${NC}"
    fi
else
    echo -e "${GREEN}✓ No Codex rules files staged${NC}"
fi

echo

#
# 5. TypeScript Type Check
#
STAGED_TS_FOR_TYPECHECK=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS_FOR_TYPECHECK" ]; then
    echo -e "${BLUE}📐 Running TypeScript type check...${NC}"
    if command -v pnpm &> /dev/null && [ -f "package.json" ] && jq -e '.scripts.typecheck' package.json &> /dev/null; then
        if ! pnpm typecheck 2>&1 | tail -20; then
            echo -e "${RED}❌ TypeScript type check failed${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ TypeScript type check passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ No typecheck script found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No TypeScript files staged${NC}"
fi

echo

#
# 6. Hook Tests (existing functionality)
#
HOOKS_PROJECT_DIR="${REPO_ROOT}"
STAGED_FILES=$(git diff --cached --name-only)

HOOK_FILES_MODIFIED=false
for file in $STAGED_FILES; do
    case "$file" in
        *claude/hooks/*)
            HOOK_FILES_MODIFIED=true
            break
            ;;
    esac
done

if [ "$HOOK_FILES_MODIFIED" = true ] || [ "${FORCE_HOOK_TESTS:-}" = "1" ]; then
    echo -e "${BLUE}🧪 Running hook tests...${NC}"

    if command -v pnpm &> /dev/null && [ -f "${HOOKS_PROJECT_DIR}/package.json" ] && jq -e '.scripts.test' "${HOOKS_PROJECT_DIR}/package.json" &> /dev/null; then
        if ! (cd "${HOOKS_PROJECT_DIR}" && pnpm test); then
            echo -e "${RED}❌ Hook tests failed!${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ Hook tests passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ No hook test runner found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No hook files modified, skipping tests${NC}"
fi

exit $EXIT_CODE
