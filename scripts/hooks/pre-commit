#!/bin/bash
# Git pre-commit hook
# - Secret detection with gitleaks
# - Hook tests when hook files are modified

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Skip if requested
if [ "${SKIP_HOOKS:-}" = "1" ]; then
    echo -e "${YELLOW}⚠ Hooks skipped (SKIP_HOOKS=1)${NC}"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
EXIT_CODE=0

#
# 1. Secret Detection (gitleaks)
#
echo -e "${BLUE}🔍 Checking for secrets...${NC}"
if command -v gitleaks &> /dev/null; then
    if ! gitleaks protect --staged --config "${REPO_ROOT}/.gitleaks.toml" --verbose; then
        echo -e "${RED}❌ Secrets detected! Remove them before committing.${NC}"
        echo -e "${YELLOW}   If false positive: update .gitleaks.toml or .gitleaksignore${NC}"
        EXIT_CODE=1
    else
        echo -e "${GREEN}✓ No secrets found${NC}"
    fi
else
    echo -e "${YELLOW}⚠ gitleaks not installed, skipping secret detection${NC}"
    echo -e "${YELLOW}  Install: mise install gitleaks${NC}"
fi

echo

#
# 2. Formatting (oxfmt) & Linting (oxlint)
#
# 2a. Format staged files via scripts/format-staged.sh
#
# 整形の対象は commit に入るファイルだけにする。リポジトリ全体を整形すると、作業ツリーに
# ある別作業の変更まで書き換わるため。oxfmt のフラグは format-staged.sh 経由で
# package.json の format:files に一本化されており、ここで再定義してはならない
# (かつて独自の oxfmt 呼び出しが `--ignore-path .oxfmtignore` を欠き、CI の format:check と
# 対象が 17 ファイルずれて整形違反が入り込んだ)。
#
# 部分 stage のファイルは整形せず、index の中身を検査して違反なら commit を止める。
# 丸ごと整形して stage し直すと未 stage の hunk まで commit に入るため。
#
# 全体 stage 以外の経路で混入した違反やフォーマッタ更新による drift は、
# 必須チェックの ci-format.yml (リポジトリ全体に format:check) が検知する。
echo -e "${BLUE}🎨 Formatting staged files...${NC}"
if command -v bun &> /dev/null; then
    if ! "${REPO_ROOT}/scripts/format-staged.sh"; then
        EXIT_CODE=1
    fi
else
    echo -e "${RED}❌ bun not found; formatting cannot be verified${NC}"
    echo -e "${YELLOW}  Install: mise install (bypass with SKIP_HOOKS=1)${NC}"
    EXIT_CODE=1
fi

echo

# 2b. Lint via the package.json script (single source of truth)
#
# 2a と同じ理由で、対象ファイル集合と ignore パターンをここで再定義しない。
# 独自呼び出しは `--ignore-pattern 'node_modules/'` を欠いており、実行系も
# npx (レジストリ解決) と CI の bun (pinned devDependency) で分かれていた。
# staged 限定をやめリポジトリ全体を対象にするのは 2a と同じ理由で、
# 全体でも 1 秒未満で完了する。
echo -e "${BLUE}🦊 Linting (bun run lint:oxlint)...${NC}"
if command -v bun &> /dev/null; then
    if ! LINT_OUTPUT=$(bun run lint:oxlint 2>&1); then
        echo -e "${RED}❌ oxlint found issues${NC}"
        # oxlint は warning でも大量に出力するため、commit を止めた error 行を
        # 明示的に拾う。error が無い失敗 (oxlint 自体の異常終了) は末尾を出す
        LINT_ERRORS=$(echo "$LINT_OUTPUT" | grep -E ': error ' || true)
        if [ -n "$LINT_ERRORS" ]; then
            echo "$LINT_ERRORS" | head -20
        else
            echo "$LINT_OUTPUT" | tail -20
        fi
        EXIT_CODE=1
    else
        echo -e "${GREEN}✓ Repository passed oxlint checks${NC}"
    fi
else
    echo -e "${RED}❌ bun not found; lint cannot be verified${NC}"
    echo -e "${YELLOW}  Install: mise install (bypass with SKIP_HOOKS=1)${NC}"
    EXIT_CODE=1
fi

echo

#
# 3. Shell Script Linting (shellcheck)
#
# lint-shell.sh classifies the paths itself (.sh, .sh.tmpl, shebang) and runs the
# version of shellcheck pinned in .mise.toml, so the hook checks what CI checks. Exit 2
# means a tool is missing; the hook warns and lets CI be the final check.
LINT_TARGETS=()
while IFS= read -r -d '' path; do
    LINT_TARGETS+=("$path")
done < <(git diff --cached --name-only -z --diff-filter=ACM)
if [ ${#LINT_TARGETS[@]} -gt 0 ]; then
    echo -e "${BLUE}🐚 Checking shell scripts with shellcheck...${NC}"
    LINT_RC=0
    "${REPO_ROOT}/scripts/lint-shell.sh" "${LINT_TARGETS[@]}" || LINT_RC=$?
    case "$LINT_RC" in
        0) echo -e "${GREEN}✓ Staged shell scripts passed shellcheck${NC}" ;;
        2) echo -e "${YELLOW}⚠ shellcheck could not run; this commit is not checked and CI is the final check (see recover: above)${NC}" ;;
        *) echo -e "${RED}❌ shellcheck found issues in staged files${NC}"; EXIT_CODE=1 ;;
    esac
else
    echo -e "${GREEN}✓ No files staged${NC}"
fi

echo

#
# 4. Codex Config Format Check
#
STAGED_CODEX_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'home/dot_codex/\.config(\.[^/]+)?\.toml|scripts/(check|format|test)-codex-config[^/]*\.sh' || true)
if [ -n "$STAGED_CODEX_FILES" ]; then
    echo -e "${BLUE}⚙️  Checking Codex config format...${NC}"
    CHECK_SCRIPT="${REPO_ROOT}/scripts/check-codex-config.sh"

    if [ -f "$CHECK_SCRIPT" ]; then
        if [ -f "${REPO_ROOT}/home/dot_codex/.config.toml" ]; then
            if "$CHECK_SCRIPT"; then
                echo -e "${GREEN}✓ Codex config is properly formatted${NC}"
            else
                echo -e "${RED}❌ Codex config needs formatting${NC}"
                echo -e "${YELLOW}  Run: ./scripts/format-codex-config.sh${NC}"
                EXIT_CODE=1
            fi
        else
            echo -e "${YELLOW}⚠ home/dot_codex/.config.toml not found, skipping${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Check script not found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No Codex config files staged${NC}"
fi

echo

#
# 4.5. Codex Execution Policy Check
#
STAGED_RULES_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'home/dot_codex/rules/' || true)
if [ -n "$STAGED_RULES_FILES" ]; then
    echo -e "${BLUE}📋 Checking Codex execution policy rules...${NC}"
    if command -v codex &> /dev/null; then
        RULES_FAILED=false
        for file in $STAGED_RULES_FILES; do
            if [ -f "$file" ]; then
                echo "  Checking: $file"
                # codex execpolicy check takes the rules file via --rules and needs a
                # command to evaluate; `true` is a placeholder, so a parse error in the
                # rules file is what makes it fail.
                if ! codex execpolicy check --rules "$file" -- true >/dev/null; then
                    RULES_FAILED=true
                fi
            fi
        done

        if [ "$RULES_FAILED" = true ]; then
            echo -e "${RED}❌ Codex execution policy check failed${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ All execution policy rules are valid${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ codex not installed, skipping execution policy check${NC}"
    fi
else
    echo -e "${GREEN}✓ No Codex rules files staged${NC}"
fi

echo

#
# 5. TypeScript Type Check
#
STAGED_TS_FOR_TYPECHECK=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS_FOR_TYPECHECK" ]; then
    echo -e "${BLUE}📐 Running TypeScript type check...${NC}"
    if command -v bun &> /dev/null && [ -f "package.json" ] && jq -e '.scripts.typecheck' package.json &> /dev/null; then
        if ! bun run typecheck 2>&1 | tail -20; then
            echo -e "${RED}❌ TypeScript type check failed${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ TypeScript type check passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ No typecheck script found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No TypeScript files staged${NC}"
fi

echo

#
# 6. Hook Tests (existing functionality)
#
HOOKS_PROJECT_DIR="${REPO_ROOT}"
STAGED_FILES=$(git diff --cached --name-only)

HOOK_FILES_MODIFIED=false
for file in $STAGED_FILES; do
    case "$file" in
        *claude/hooks/*)
            HOOK_FILES_MODIFIED=true
            break
            ;;
    esac
done

if [ "$HOOK_FILES_MODIFIED" = true ] || [ "${FORCE_HOOK_TESTS:-}" = "1" ]; then
    echo -e "${BLUE}🧪 Running hook tests...${NC}"

    if command -v bun &> /dev/null && [ -f "${HOOKS_PROJECT_DIR}/package.json" ] && jq -e '.scripts.test' "${HOOKS_PROJECT_DIR}/package.json" &> /dev/null; then
        if ! (cd "${HOOKS_PROJECT_DIR}" && bun run test); then
            echo -e "${RED}❌ Hook tests failed!${NC}"
            EXIT_CODE=1
        else
            echo -e "${GREEN}✓ Hook tests passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ No hook test runner found, skipping${NC}"
    fi
else
    echo -e "${GREEN}✓ No hook files modified, skipping tests${NC}"
fi

echo

#
# 7. .chezmoiremove coverage
#
# A target whose source file is removed stays on every machine that applied it
# unless home/.chezmoiremove lists it. Additions count too: restoring a removed
# file while its .chezmoiremove line remains would delete the restored file on
# every apply.
#
# The check is split in two files. tests/chezmoiremove-coverage.test.mjs holds
# the pure-function cases, which the full `bun run test` above already runs, so
# it runs here only when that suite was skipped. tests/heavy/ holds the cases
# that read the real repository through git. `bun run test` does not include
# them, so they run here whenever an input changed, whatever step 6 did.
# CLAUDE_TEST_FORBID_GIT='' keeps a git shim leaked from a parent environment
# from failing them.
CHEZMOIREMOVE_INPUTS_CHANGED=false
if [ -n "$(git diff --cached --name-only --diff-filter=ADR -- home/)" ]; then
    CHEZMOIREMOVE_INPUTS_CHANGED=true
fi
for file in $STAGED_FILES; do
    case "$file" in
        home/.chezmoiremove | home/.chezmoiignore | home/.chezmoiexternal.toml.tmpl | \
            tests/chezmoiremove-coverage.test.mjs | tests/heavy/chezmoiremove-coverage.test.mjs | \
            tests/lib/chezmoiremove-coverage.mjs)
            CHEZMOIREMOVE_INPUTS_CHANGED=true
            break
            ;;
    esac
done

if [ "$CHEZMOIREMOVE_INPUTS_CHANGED" = true ]; then
    echo -e "${BLUE}🧹 Checking .chezmoiremove coverage...${NC}"
    CHEZMOIREMOVE_OK=true
    if [ "$HOOK_FILES_MODIFIED" != true ] && [ "${FORCE_HOOK_TESTS:-}" != "1" ]; then
        if ! (cd "${REPO_ROOT}" && node --import ./home/dot_claude/hooks/tests/preload-test-env.mjs --test tests/chezmoiremove-coverage.test.mjs); then
            CHEZMOIREMOVE_OK=false
        fi
    fi
    if ! (cd "${REPO_ROOT}" && CLAUDE_TEST_FORBID_GIT='' node --import ./home/dot_claude/hooks/tests/preload-test-env.mjs --test tests/heavy/chezmoiremove-coverage.test.mjs); then
        CHEZMOIREMOVE_OK=false
    fi
    if [ "$CHEZMOIREMOVE_OK" = true ]; then
        echo -e "${GREEN}✓ .chezmoiremove covers removed source files${NC}"
    else
        echo -e "${RED}❌ .chezmoiremove coverage check failed (the test output above names the lines to add or remove)${NC}"
        EXIT_CODE=1
    fi
fi

exit "$EXIT_CODE"
