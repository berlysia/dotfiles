# File types that oxfmt does not format
*.toml
*.sh
*.tmpl

# Lock files are managed by package managers
pnpm-lock.yaml
bun.lock
package-lock.json
yarn.lock

# Verbatim upstream copies: formatting them would mix formatter noise into diffs when pulling upstream updates
.skills/tanteki/
.skills/yomiyasu/
.skills/imozuru/

# Digit-1 template notation makes oxfmt fail with a syntax error
.skills/claude-action-bootstrap/assets/workflows/auto-fix-dependencies.yml

# Frozen --json v1 contract fixtures: their SHA-256 is pinned by a test, so formatting must not change the bytes
home/dot_claude/hooks/tests/fixtures/sessions/cli-output.v1*.json
