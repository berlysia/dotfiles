{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>berlysia/renovate-config"],
  "packageRules": [
    {
      "description": "Auto-merge non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Keep mise cargo: backend versions bare. The preset's rangeStrategy=pin writes cargo range syntax (=1.2.3), which mise rejects as an unsupported semver range; bump updates the bare version in place instead",
      "matchManagers": ["mise"],
      "matchDatasources": ["crate"],
      "rangeStrategy": "bump"
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "^dot_config/mise/config\\.toml$",
      "^\\.mise\\.toml$"
    ]
  }
}
