{
  "name": "@berlysia-dotfiles/root",
  "version": "1.0.0",
  "private": true,
  "description": "Dotfiles managed by chezmoi with Claude Code hooks",
  "keywords": [],
  "author": "",
  "workspaces": [
    "home/dot_claude"
  ],
  "type": "module",
  "scripts": {
    "test": "CLAUDE_TEST_FORBID_GIT=1 node --import ./home/dot_claude/hooks/tests/preload-test-env.mjs --test home/dot_claude/hooks/tests/unit/*.test.ts tests/tailnet-ssh.test.mjs tests/usage-line-statusline.test.mjs tests/chezmoiremove-coverage.test.mjs tests/install-chezmoi.test.mjs tests/ja-baseline.test.mjs tests/formal-check.test.mjs tests/ai-usage-summary.test.mjs tests/delegation-schema.test.mjs tests/delegation-store.test.mjs tests/delegation-pace-route.test.mjs tests/delegation-cli.test.mjs",
    "test:perf": "CLAUDE_TEST_FORBID_GIT= node --import ./home/dot_claude/hooks/tests/preload-test-env.mjs --test --test-concurrency=1 home/dot_claude/hooks/tests/perf/*.test.ts",
    "test:heavy": "CLAUDE_TEST_FORBID_GIT= node --import ./home/dot_claude/hooks/tests/preload-test-env.mjs --test --test-concurrency=1 home/dot_claude/hooks/tests/heavy/*.test.ts tests/heavy/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:files": "oxfmt --ignore-path .oxfmtignore --no-error-on-unmatched-pattern",
    "format": "bun run format:files .",
    "format:check": "bun run format:files --check .",
    "ci:local": "./scripts/ci-local.sh all",
    "ci:local:codex": "./scripts/ci-local.sh codex",
    "ci:local:lint": "./scripts/ci-local.sh lint",
    "ci:local:shell": "./scripts/ci-local.sh shell",
    "ci:local:typescript": "./scripts/ci-local.sh typescript",
    "lint:shell": "./scripts/lint-shell.sh",
    "smoke:chezmoi": "./scripts/smoke-chezmoi-scripts.sh",
    "smoke:provisioning": "./scripts/smoke-provisioning-invariants.sh",
    "lint:actions": "./scripts/lint-actions.sh",
    "test:agent-vm": "bash tests/agent-vm/run.sh",
    "test:dotfiles-sync-doctor": "bash tests/dotfiles-sync-doctor/run.sh",
    "test:install-packages": "bash tests/install-packages/run.sh",
    "test:format-staged": "bash tests/format-staged/run.sh",
    "test:shell-gate": "bash tests/shell-gate/run.sh",
    "test:claude-wrapper": "bash tests/claude-wrapper/run.sh",
    "lint:codex": "./scripts/check-codex-config.sh",
    "lint:oxlint": "oxlint --ignore-pattern '.claude/skills/' --ignore-pattern '.codex/skills/' --ignore-pattern '.skills/' --ignore-pattern 'mods/' --ignore-pattern 'node_modules/' .",
    "lint": "npm run format:check && npm run lint:oxlint && npm run lint:shell && npm run lint:actions && npm run lint:codex",
    "check": "npm run test && npm run test:perf && npm run test:heavy && npm run typecheck && npm run lint",
    "prepare": "./scripts/install-hooks.sh"
  },
  "dependencies": {
    "@drawio/mcp": "1.10.0",
    "@playwright/mcp": "0.0.83",
    "@upstash/context7-mcp": "4.4.3",
    "chrome-devtools-mcp": "1.11.0",
    "supergateway": "4.2.0"
  },
  "devDependencies": {
    "@mizchi/lsmcp": "0.10.0",
    "@types/node": "26.6.5",
    "fallow": "3.34.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
